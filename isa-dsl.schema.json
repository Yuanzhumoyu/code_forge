{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yuanzhumoyu/code_forge/isa-dsl.schema.json",
  "title": "ISA-DSL v18 谱（TOML）",
  "description": "由 forge-isa-dsl 的 schema 表发射（v18 S7c）；三方守卫见 crates/frontend/forge-isa-dsl/tests/schema_guard.rs",
  "type": "object",
  "properties": {"meta":{"$ref":"#/$defs/section1"},
    "encoding":{"$ref":"#/$defs/section2"},
    "reg":{"type":"object","additionalProperties":{"$ref":"#/$defs/section3"}},
    "types":{"$ref":"#/$defs/section5"},
    "conventions":{"type":"object","description":"bitfields / modrm / cond / prefix_scan / mem"},
    "stack":{"$ref":"#/$defs/section4"},
    "operand_slots":{"type":"array","items":{"$ref":"#/$defs/section12"}},
    "forms":{"type":"array","items":{"$ref":"#/$defs/section13"}},
    "instructions":{"type":"array","items":{"$ref":"#/$defs/section14"}},
    "templates":{"type":"array","items":{"$ref":"#/$defs/section15"}},
    "reloc":{"type":"array","items":{"$ref":"#/$defs/section16"}},
    "derive":{"type":"array","items":{"$ref":"#/$defs/section17"}},
    "pseudo":{"type":"array","items":{"$ref":"#/$defs/section18"}},
    "lowering":{"type":"array","items":{"$ref":"#/$defs/section19"}},
    "pattern":{"type":"array","items":{"$ref":"#/$defs/section20"}},
    "abi":{"$ref":"#/$defs/section21"},
    "emit":{"$ref":"#/$defs/section26"},
    "spill":{"type":"object","description":"溢出模板表（键 = 名字）"}},
  "required": ["meta"],
  "$defs": {"section0":{"title":"<root>","description":"ISA 谱根（`include`/`[[override]]` 为多文件组合键，由 loader 合并后才进模型）","type":"object","properties":{"meta":{"description":"<root>.meta"},"include":{"description":"<root>.include"},"override":{"description":"<root>.override"},"encoding":{"description":"<root>.encoding"},"reg":{"description":"<root>.reg"},"conventions":{"description":"<root>.conventions"},"types":{"description":"<root>.types"},"stack":{"description":"<root>.stack"},"operand_slots":{"description":"<root>.operand_slots"},"forms":{"description":"<root>.forms"},"instructions":{"description":"<root>.instructions"},"templates":{"description":"<root>.templates"},"reloc":{"description":"<root>.reloc"},"derive":{"description":"<root>.derive"},"pseudo":{"description":"<root>.pseudo"},"lowering":{"description":"<root>.lowering"},"pattern":{"description":"<root>.pattern"},"abi":{"description":"<root>.abi"},"emit":{"description":"<root>.emit"},"spill":{"description":"<root>.spill"}},"required":["meta"],"additionalProperties":false},
    "section1":{"title":"[meta]","description":"元信息 + 宽度元数据（缺省从 [reg.*] 派生）","type":"object","properties":{"name":{"description":"[meta].name"},"version":{"description":"[meta].version"},"endian":{"description":"[meta].endian"},"mode":{"description":"[meta].mode"},"case_insensitive_regs":{"description":"[meta].case_insensitive_regs"},"comment_char":{"description":"[meta].comment_char"},"label_suffix":{"description":"[meta].label_suffix"},"mnemonic_case":{"description":"[meta].mnemonic_case"},"imm_prefix":{"description":"[meta].imm_prefix"},"directive_prefix":{"description":"[meta].directive_prefix"},"default_gpr_width":{"description":"[meta].default_gpr_width"},"default_fpr_width":{"description":"[meta].default_fpr_width"},"addr_width":{"description":"[meta].addr_width"},"value_gpr_width":{"description":"[meta].value_gpr_width"},"value_fpr_width":{"description":"[meta].value_fpr_width"},"vector_tiers":{"description":"[meta].vector_tiers"}},"required":["name"],"additionalProperties":false},
    "section2":{"title":"[encoding]","description":"指令宽度三态：fixed | mixed | prefix_scan（v18 S4）","type":"object","properties":{"kind":{"description":"[encoding].kind"},"bits":{"description":"[encoding].bits"},"widths":{"description":"[encoding].widths"},"max_len":{"description":"[encoding].max_len"},"default_opsize":{"description":"[encoding].default_opsize"}},"required":["kind"],"additionalProperties":false},
    "section3":{"title":"[reg.<name>]","description":"寄存器组；组名的数字 = 字节宽（gpr8 = 64 位）","type":"object","properties":{"names":{"description":"[reg.<name>].names"},"prefix":{"description":"[reg.<name>].prefix"},"base_index":{"description":"[reg.<name>].base_index"},"count":{"description":"[reg.<name>].count"}},"required":[],"additionalProperties":false},
    "section4":{"title":"[stack]","description":"栈槽单位/对齐/帧指针保存槽（缺省全部派生）","type":"object","properties":{"slot":{"description":"[stack].slot"},"align":{"description":"[stack].align"},"fp_save":{"description":"[stack].fp_save"}},"required":[],"additionalProperties":false},
    "section5":{"title":"[types]","description":"类型 → 寄存器组名（或 \"unsupported\"）的显式映射；键 = 类型名","type":"object","properties":{},"required":[],"additionalProperties":true},
    "section6":{"title":"[conventions.bitfields.<name>]","description":"命名位域：offset/width，或 pieces 列出散布位段","type":"object","properties":{"offset":{"description":"[conventions.bitfields.<name>].offset"},"width":{"description":"[conventions.bitfields.<name>].width"},"pieces":{"description":"[conventions.bitfields.<name>].pieces"}},"required":[],"additionalProperties":false},
    "section7":{"title":"[[conventions.bitfields.<name>.pieces]]","description":"散布位段：`value >> shift` 取 width 位放在 offset","type":"object","properties":{"offset":{"description":"[[conventions.bitfields.<name>.pieces]].offset"},"width":{"description":"[[conventions.bitfields.<name>.pieces]].width"},"shift":{"description":"[[conventions.bitfields.<name>.pieces]].shift"}},"required":["offset","width"],"additionalProperties":false},
    "section8":{"title":"[conventions.modrm]","description":"ModRM 约定（表存在即启用）：reg/rm 位域名 + 强制位移的 base 寄存器号","type":"object","properties":{"reg_field":{"description":"[conventions.modrm].reg_field"},"rm_field":{"description":"[conventions.modrm].rm_field"},"force_disp_base":{"description":"[conventions.modrm].force_disp_base"}},"required":[],"additionalProperties":false},
    "section9":{"title":"[conventions.cond]","description":"条件码表：键 = 汇编可见的条件名（也允许 `名 = <整数>` 简写）","type":"object","properties":{"code":{"description":"[conventions.cond].code"},"ir":{"description":"[conventions.cond].ir"}},"required":["code"],"additionalProperties":true},
    "section10":{"title":"[[conventions.prefix_scan]]","description":"变长前缀扫描表（缺省 = x86 集）","type":"object","properties":{"byte":{"description":"[[conventions.prefix_scan]].byte"},"range":{"description":"[[conventions.prefix_scan]].range"},"effects":{"description":"[[conventions.prefix_scan]].effects"}},"required":[],"additionalProperties":false},
    "section11":{"title":"[conventions.mem]","description":"内存操作数文本模板（缺省 x86 `[{base}+{index}*{scale}+{disp}]`）","type":"object","properties":{"template":{"description":"[conventions.mem].template"}},"required":["template"],"additionalProperties":false},
    "section12":{"title":"[[operand_slots]]","description":"操作数槽：kind = reg | imm | mem | label | cond","type":"object","properties":{"name":{"description":"[[operand_slots]].name"},"kind":{"description":"[[operand_slots]].kind"},"class":{"description":"[[operand_slots]].class"},"classes":{"description":"[[operand_slots]].classes"},"byte_reg":{"description":"[[operand_slots]].byte_reg"},"width":{"description":"[[operand_slots]].width"},"signed":{"description":"[[operand_slots]].signed"},"float":{"description":"[[operand_slots]].float"},"min":{"description":"[[operand_slots]].min"},"max":{"description":"[[operand_slots]].max"},"roles":{"description":"[[operand_slots]].roles"}},"required":["name","kind"],"additionalProperties":false},
    "section13":{"title":"[[forms]]","description":"编码形式：可选的键预设（指令可逐键覆盖）","type":"object","properties":{"name":{"description":"[[forms]].name"},"modrm":{"description":"[[forms]].modrm（编码键，可与 form 预设混用）"},"modrm_fixed":{"description":"[[forms]].modrm_fixed（编码键，可与 form 预设混用）"},"rex":{"description":"[[forms]].rex（编码键，可与 form 预设混用）"},"vex":{"description":"[[forms]].vex（编码键，可与 form 预设混用）"},"evex":{"description":"[[forms]].evex（编码键，可与 form 预设混用）"},"prefix":{"description":"[[forms]].prefix（编码键，可与 form 预设混用）"},"opsize":{"description":"[[forms]].opsize（编码键，可与 form 预设混用）"},"rex_w":{"description":"[[forms]].rex_w（编码键，可与 form 预设混用）"},"opcode_reg":{"description":"[[forms]].opcode_reg（编码键，可与 form 预设混用）"},"imm":{"description":"[[forms]].imm（编码键，可与 form 预设混用）"},"escape":{"description":"[[forms]].escape（编码键，可与 form 预设混用）"},"opcode_field":{"description":"[[forms]].opcode_field（编码键，可与 form 预设混用）"},"operand_fields":{"description":"[[forms]].operand_fields（编码键，可与 form 预设混用）"}},"required":["name"],"additionalProperties":false},
    "section14":{"title":"[[instructions]]","description":"指令：编码键可与 form 预设混用（指令优先）","type":"object","properties":{"name":{"description":"[[instructions]].name"},"asm":{"description":"[[instructions]].asm"},"form":{"description":"[[instructions]].form"},"opcode":{"description":"[[instructions]].opcode"},"fields":{"description":"[[instructions]].fields"},"ops":{"description":"[[instructions]].ops"},"when":{"description":"[[instructions]].when"},"effect":{"description":"[[instructions]].effect"},"roles":{"description":"[[instructions]].roles"},"implicit_regs":{"description":"[[instructions]].implicit_regs"},"reloc":{"description":"[[instructions]].reloc"},"width":{"description":"[[instructions]].width"},"ref":{"description":"[[instructions]].ref"},"modrm":{"description":"[[instructions]].modrm（编码键，可与 form 预设混用）"},"modrm_fixed":{"description":"[[instructions]].modrm_fixed（编码键，可与 form 预设混用）"},"rex":{"description":"[[instructions]].rex（编码键，可与 form 预设混用）"},"vex":{"description":"[[instructions]].vex（编码键，可与 form 预设混用）"},"evex":{"description":"[[instructions]].evex（编码键，可与 form 预设混用）"},"prefix":{"description":"[[instructions]].prefix（编码键，可与 form 预设混用）"},"opsize":{"description":"[[instructions]].opsize（编码键，可与 form 预设混用）"},"rex_w":{"description":"[[instructions]].rex_w（编码键，可与 form 预设混用）"},"opcode_reg":{"description":"[[instructions]].opcode_reg（编码键，可与 form 预设混用）"},"imm":{"description":"[[instructions]].imm（编码键，可与 form 预设混用）"},"escape":{"description":"[[instructions]].escape（编码键，可与 form 预设混用）"},"opcode_field":{"description":"[[instructions]].opcode_field（编码键，可与 form 预设混用）"},"operand_fields":{"description":"[[instructions]].operand_fields（编码键，可与 form 预设混用）"}},"required":["name","asm"],"additionalProperties":false},
    "section15":{"title":"[[templates]]","description":"唯一指令复用机制：`body` 共享字段 + `rows` 每行一条指令","type":"object","properties":{"rows":{"description":"[[templates]].rows"},"name":{"description":"[[templates]].name"},"body":{"description":"[[templates]].body"}},"required":["rows"],"additionalProperties":false},
    "section16":{"title":"[[reloc]]","description":"重定位表：semantics = absolute | pc_relative（v18 S3d）","type":"object","properties":{"name":{"description":"[[reloc]].name"},"semantics":{"description":"[[reloc]].semantics"},"slot":{"description":"[[reloc]].slot"},"addend":{"description":"[[reloc]].addend"}},"required":["name","semantics","slot"],"additionalProperties":false},
    "section17":{"title":"[[derive]]","description":"派生谓词属性（v18 S3f）","type":"object","properties":{"name":{"description":"[[derive]].name"},"expr":{"description":"[[derive]].expr"}},"required":["name","expr"],"additionalProperties":false},
    "section18":{"title":"[[pseudo]]","description":"汇编器伪指令：文本级多指令展开（v18 S3e）","type":"object","properties":{"name":{"description":"[[pseudo]].name"},"params":{"description":"[[pseudo]].params"},"emit":{"description":"[[pseudo]].emit"}},"required":["name","params","emit"],"additionalProperties":false},
    "section19":{"title":"[[lowering]]","description":"指令选择规则","type":"object","properties":{"op":{"description":"[[lowering]].op"},"insts":{"description":"[[lowering]].insts"},"when":{"description":"[[lowering]].when"},"vary":{"description":"[[lowering]].vary"},"priority":{"description":"[[lowering]].priority"}},"required":["op","insts"],"additionalProperties":false},
    "section20":{"title":"[[pattern]]","description":"树型多指令匹配（`match` 是 Rust 关键字，模型里写作 `r#match`）","type":"object","properties":{"insts":{"description":"[[pattern]].insts"},"when":{"description":"[[pattern]].when"},"match":{"description":"[[pattern]].match"}},"required":["insts"],"additionalProperties":false},
    "section21":{"title":"[abi]","description":"调用约定","type":"object","properties":{"frame_padding":{"description":"[abi].frame_padding"},"stack_args":{"description":"[abi].stack_args"},"arg_class":{"description":"[abi].arg_class"},"frame":{"description":"[abi].frame"},"callee_saved":{"description":"[abi].callee_saved"},"scratch":{"description":"[abi].scratch"},"ret_regs":{"description":"[abi].ret_regs"},"call_ret_reg":{"description":"[abi].call_ret_reg"},"call_clobbers":{"description":"[abi].call_clobbers"},"reserved":{"description":"[abi].reserved"},"arg_slot":{"description":"[abi].arg_slot"}},"required":[],"additionalProperties":false},
    "section22":{"title":"[abi.frame]","description":"帧布局","type":"object","properties":{"sp":{"description":"[abi.frame].sp"},"fp":{"description":"[abi.frame].fp"},"layout":{"description":"[abi.frame].layout"},"fp_push_bytes":{"description":"[abi.frame].fp_push_bytes"},"alloc_neg":{"description":"[abi.frame].alloc_neg"}},"required":[],"additionalProperties":false},
    "section23":{"title":"[abi.stack_args]","description":"栈参数布局（全部由 ISA 数据给出）","type":"object","properties":{"callee_base":{"description":"[abi.stack_args].callee_base"},"caller_base":{"description":"[abi.stack_args].caller_base"},"first_offset_slots":{"description":"[abi.stack_args].first_offset_slots"},"stride_slots":{"description":"[abi.stack_args].stride_slots"},"shadow_bytes":{"description":"[abi.stack_args].shadow_bytes"}},"required":[],"additionalProperties":false},
    "section24":{"title":"[abi.arg_class]","description":"参数寄存器类/顺序/策略/by-value 阈值","type":"object","properties":{"class":{"description":"[abi.arg_class].class"},"regs":{"description":"[abi.arg_class].regs"},"strategy":{"description":"[abi.arg_class].strategy"},"limit":{"description":"[abi.arg_class].limit"}},"required":[],"additionalProperties":false},
    "section25":{"title":"[abi.callee_saved]","description":"被调用者保存寄存器名单","type":"object","properties":{"gpr":{"description":"[abi.callee_saved].gpr"},"xmm":{"description":"[abi.callee_saved].xmm"}},"required":[],"additionalProperties":false},
    "section26":{"title":"[emit]","description":"序言/尾声块引用","type":"object","properties":{"prologue":{"description":"[emit].prologue"},"epilogue":{"description":"[emit].epilogue"},"align_pad":{"description":"[emit].align_pad"},"epilogue_label":{"description":"[emit].epilogue_label"}},"required":[],"additionalProperties":false},
    "section27":{"title":"[spill.<name>]","description":"溢出/回填模板（`{N}` = 寄存器序号占位符）","type":"object","properties":{"load":{"description":"[spill.<name>].load"},"store":{"description":"[spill.<name>].store"},"base":{"description":"[spill.<name>].base"}},"required":[],"additionalProperties":false},
    "section28":{"title":"enc / vex / evex / modrm（内联子表）","description":"`modrm = { reg = <名|整数>, rm = <名|\"[base]\"> }`","type":"object","properties":{"reg":{"description":"enc / vex / evex / modrm（内联子表）.reg"},"rm":{"description":"enc / vex / evex / modrm（内联子表）.rm"}},"required":[],"additionalProperties":false},
    "section29":{"title":"vex / evex（内联子表）","description":"VEX/EVEX 结构键（map/pp/w/l + AVX-512 的 b/z/disp_scale）","type":"object","properties":{"map":{"description":"vex / evex（内联子表）.map"},"pp":{"description":"vex / evex（内联子表）.pp"},"w":{"description":"vex / evex（内联子表）.w"},"l":{"description":"vex / evex（内联子表）.l"},"b":{"description":"vex / evex（内联子表）.b"},"z":{"description":"vex / evex（内联子表）.z"},"disp_scale":{"description":"vex / evex（内联子表）.disp_scale"}},"required":[],"additionalProperties":false},
    "section30":{"title":"[[templates.rows]]","description":"模板行：`inst` + 任意指令字段（含 `ref`）","type":"object","properties":{"inst":{"description":"[[templates.rows]].inst"}},"required":["inst"],"additionalProperties":true},
    "section31":{"title":"[emit.<block>]","description":"序言/尾声块内容","type":"object","properties":{"insts":{"description":"[emit.<block>].insts"}},"required":[],"additionalProperties":false},
    "section32":{"title":"[[override]]","description":"多文件组合：显式覆盖被包含文件里的键（点分路径 + 新值；由 loader 消费）","type":"object","properties":{"key":{"description":"[[override]].key"},"value":{"description":"[[override]].value"}},"required":["key","value"],"additionalProperties":false}
  }
}
