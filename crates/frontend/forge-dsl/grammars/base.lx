# base.lx — 汇编 DSL 基础语法
# 定义语言通用结构。ISA 特定扩展由 TOML [lang_*] 提供。

# ── 数字字面量 (不可推导) ──
token HEX   = "0x[0-9a-fA-F_]+"
token BIN   = "0b[01_]+"
token OCT   = "0o[0-7_]+"
token DEC   = "[0-9][0-9_]*"
token FLOAT = "[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?"

# ── 字符串 ──
token STRING = '"[^"]*"'

# ── 标识符/寄存器 (默认定义，TOML 可覆盖) ──
token IDENT = "[a-z_][a-zA-Z0-9_]*"
token REG   = "[A-Z][A-Z0-9]*"
token TEMP  = "%[a-zA-Z_][a-zA-Z0-9_]*(:[a-zA-Z_][a-zA-Z0-9_]*)?"
token LABEL = "\.[a-zA-Z_][a-zA-Z0-9_]*"
token VREG  = "VReg\([0-9]+\)"

# ── 标点 ──
punct "(" ")" "{" "}" "[" "]" "," ":" ";" "=" "@"
punct "+" "-" "*" "/" "%" "#"
punct "<" ">" "<=" ">=" "==" "!="
punct "&&" "||" "!" "~" "&" "|" "->"

# ── 空白和注释 ──
skip "[\n \t\r]+"
# 注释只匹配 "#!" 开头的行（Rust 风格）——"#16"/"#-16" 是立即数，不能被当注释跳过
skip "#![^\n]*"

# ═══════════════════════════════════════
# 高层语法结构
# ═══════════════════════════════════════

program ::= item*

item ::= macro_def | stmt

macro_def ::= IDENT IDENT* "(" param_list ")" block
            | IDENT IDENT* block

param_list ::= param ("," param)*

param ::= IDENT
       | "(" IDENT ("," IDENT)* ")"

block ::= "{" stmt* "}"

stmt ::= inst_like | label_def | pseudo_call

inst_like ::= IDENT (operand ("," operand)*)? block*

label_def ::= LABEL ":"

pseudo_call ::= "@" IDENT

# ── 表达式 ──
expr ::= comparison (("&&" | "||") comparison)*
comparison ::= additive (("<" | ">" | "<=" | ">=" | "==" | "!=") additive)?
additive ::= multiplicative (("+" | "-") multiplicative)*
multiplicative ::= unary (("*" | "/" | "%") unary)*
unary ::= ("-" | "!" | "~") unary | primary
primary ::= DEC | FLOAT | STRING | IDENT | TEMP | VREG | "(" expr ")"
         | IDENT "(" expr ("," expr)* ")"

# ── 操作数 (由 TOML [lang_tokens] + inst.*.asm 动态扩展) ──
operand ::= IDENT | REG | TEMP | LABEL | VREG
         |  HEX | BIN | OCT | DEC | FLOAT | STRING
         |  "(" expr ")"
         |  "[" expr "]"
