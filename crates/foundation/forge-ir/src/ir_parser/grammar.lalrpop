// forge-ir LLVM IR 语法（lalrpop 0.23）。
// 产出 ParsedModule（中间 AST），由 semantics.rs 构建 forge IR。

use std::string::String;
use super::ast_items::*;
use super::lexer::{LexError, Token, VecElem};

grammar;

extern {
    type Location = usize;
    type Error = LexError;
    enum Token {
        Define => Token::Define,
        Declare => Token::Declare,
        Target => Token::Target,
        Triple => Token::Triple,
        Datalayout => Token::Datalayout,
        SourceFilenameKw => Token::SourceFilenameKw,
        ModuleAsmKw => Token::ModuleAsmKw,
        Ret => Token::Ret,
        Br => Token::Br,
        Switch => Token::Switch,
        Unreachable => Token::Unreachable,
        VoidTy => Token::VoidTy,
        LabelTy => Token::LabelTy,
        PtrTy => Token::PtrTy,
        OpaqueKw => Token::OpaqueKw,
        VscaleTy => Token::VscaleTy(<VecElem>),
        TokenKw => Token::TokenKw,
        X => Token::X,
        IntTy => Token::IntTy(<u32>),
        FloatTy => Token::FloatTy(<u16>),
        VecTy => Token::VecTy(<VecElem>),
        GlobalId => Token::GlobalId(<String>),
        LocalId => Token::LocalId(<String>),
        Ident => Token::Ident(<String>),
        LabelStr => Token::LabelStr(<String>),
        HexLit => Token::HexLit(<crate::big::Big>),
        FloatHexLit => Token::FloatHexLit(<i64>),
        FloatLit => Token::FloatLit(<f64>),
        HexFloatLit => Token::HexFloatLit(<f64>),
        IntLit => Token::IntLit(<crate::big::Big>),
        MetadataFieldTupleLit => Token::MetadataFieldTupleLit(<String>),
        GlobalPtrInitKw => Token::GlobalPtrInitKw(<String>),
        DbgValueKw => Token::DbgValueKw,
        DbgDeclareKw => Token::DbgDeclareKw,
        DbgDeclareValueKw => Token::DbgDeclareValueKw,
        DbgAssignKw => Token::DbgAssignKw,
        DbgLabelKw => Token::DbgLabelKw,
        DbgKillKw => Token::DbgKillKw,
        SummaryKw => Token::SummaryKw(<String>),
        StrLit => Token::StrLit(<String>),
        LParen => Token::LParen,
        RParen => Token::RParen,
        LBrace => Token::LBrace,
        RBrace => Token::RBrace,
        LBracket => Token::LBracket,
        RBracket => Token::RBracket,
        LAngle => Token::LAngle,
        RAngle => Token::RAngle,
        Comma => Token::Comma,
        Colon => Token::Colon,
        Eq => Token::Eq,
        Star => Token::Star,
        AttrGroupId => Token::AttrGroupId(<u32>),
        Attributes => Token::Attributes,
        MetadataIdKw => Token::MetadataIdKw(<u32>),
        MetadataDefKw => Token::MetadataDefKw(<String>),
        MetadataNameKw => Token::MetadataNameKw(<String>),
        MetadataKw => Token::MetadataKw,
        Bang => Token::Bang,
        // 指令/值关键字
        Icmp => Token::Icmp,
        Fcmp => Token::Fcmp,
        // 二元指令（S2）
        Add => Token::Add,
        Sub => Token::Sub,
        Mul => Token::Mul,
        Udiv => Token::Udiv,
        Sdiv => Token::Sdiv,
        Urem => Token::Urem,
        Srem => Token::Srem,
        Shl => Token::Shl,
        Lshr => Token::Lshr,
        Ashr => Token::Ashr,
        And => Token::And,
        Or => Token::Or,
        Xor => Token::Xor,
        Fadd => Token::Fadd,
        Fsub => Token::Fsub,
        Fmul => Token::Fmul,
        Fdiv => Token::Fdiv,
        Frem => Token::Frem,
        Call => Token::Call,
        Tail => Token::Tail,
        Musttail => Token::Musttail,
        Notail => Token::Notail,
        Alloca => Token::Alloca,
        Load => Token::Load,
        Store => Token::Store,
        GetElementPtr => Token::GetElementPtr,
        Inbounds => Token::Inbounds,
        AtomicRmwKw => Token::AtomicRmwKw,
        CmpxchgKw => Token::CmpxchgKw,
        FenceKw => Token::FenceKw,
        Weak => Token::WeakKw,
        AddrspaceKw => Token::AddrspaceKw,
        UnnamedAddrKw => Token::UnnamedAddrKw,
        LocalUnnamedAddrKw => Token::LocalUnnamedAddrKw,
        Section => Token::SectionKw,
        ThreadLocalKw => Token::ThreadLocalKw,
        ThreadLocalModelKw => Token::ThreadLocalModelKw(<String>),
        HiddenKw => Token::HiddenKw,
        ProtectedKw => Token::ProtectedKw,
        ComdatKw => Token::ComdatKw,
        ComdatName => Token::ComdatName(<String>),
        TypeKw => Token::TypeKw,
        ExtractValueKw => Token::ExtractValueKw,
        ExtractElementKw => Token::ExtractElementKw,
        InsertElementKw => Token::InsertElementKw,
        ShuffleVectorKw => Token::ShuffleVectorKw,
        MaskVecLit => Token::MaskVecLit(<String>),
        InsertValueKw => Token::InsertValueKw,
        Private => Token::Private,
        Internal => Token::Internal,
        External => Token::External,
        WeakOdrKw => Token::WeakOdrKw,
        LinkonceKw => Token::LinkonceKw,
        LinkonceOdrKw => Token::LinkonceOdrKw,
        AppendingKw => Token::AppendingKw,
        AvailableExternallyKw => Token::AvailableExternallyKw,
        ExternWeakKw => Token::ExternWeakKw,
        CommonKw => Token::CommonKw,
        ExternallyInitializedKw => Token::ExternallyInitializedKw,
        DllImportKw => Token::DllImportKw,
        DllExportKw => Token::DllExportKw,
        DsoLocal => Token::DsoLocal,
        CString => Token::CString(<String>),
        Volatile => Token::Volatile,
        Align => Token::Align,
        Signext => Token::Signext,
        ImmargKw => Token::ImmargKw,
        Zeroext => Token::Zeroext,
        Noalias => Token::Noalias,
        AliasKw => Token::AliasKw,
        Noundef => Token::Noundef,
        Readonly => Token::Readonly,
        Writeonly => Token::Writeonly,
        Nocapture => Token::Nocapture,
        Nonnull => Token::Nonnull,
        InregKw => Token::InregKw,
        ByvalKw => Token::ByvalKw,
        SretKw => Token::SretKw,
        Nsw => Token::Nsw,
        Nuw => Token::Nuw,
        Exact => Token::Exact,
        Nneg => Token::Nneg,
        Disjoint => Token::Disjoint,
        Samesign => Token::Samesign,
        Nusw => Token::Nusw,
        InrangeKw => Token::InrangeKw,
        Fast => Token::Fast,
        Nnan => Token::Nnan,
        Ninf => Token::Ninf,
        Nsz => Token::Nsz,
        Arcp => Token::Arcp,
        Contract => Token::Contract,
        Afn => Token::Afn,
        Reassoc => Token::Reassoc,
        Fastcc => Token::Fastcc,
        Win64cc => Token::Win64cc,
        Cc => Token::Cc,
        Nounwind => Token::Nounwind,
        Noinline => Token::Noinline,
        Alwaysinline => Token::Alwaysinline,
        Norecurse => Token::Norecurse,
        Optnone => Token::Optnone,
        True => Token::True,
        False => Token::False,
        Null => Token::Null,
        Undef => Token::Undef,
        Poison => Token::Poison,
        NoneKw => Token::NoneKw,
        SyncscopeKw => Token::SyncscopeKw,
        ElementwiseKw => Token::ElementwiseKw,
        IfuncKw => Token::IfuncKw,
        DereferenceableKw => Token::DereferenceableKw,
        DereferenceableOrNullKw => Token::DereferenceableOrNullKw,
        UselistorderKw => Token::UselistorderKw,
        SspKw => Token::SspKw,
        DsoLocalEquivalentKw => Token::DsoLocalEquivalentKw,
        PtrtoaddrKw => Token::PtrtoaddrKw,
        ElementtypeKw => Token::ElementtypeKw,
        ElementtypeFnKw => Token::ElementtypeFnKw(<String>),
        GcLiveKw => Token::GcLiveKw(<String>),
        CallbrKw => Token::CallbrKw,
        ConvergentKw => Token::ConvergentKw,
        StrictfpKw => Token::StrictfpKw,
        FuncOpenAttrKw => Token::FuncOpenAttrKw(<String>),
        ParenAttrKw => Token::ParenAttrKw(<String>),
        ReturnedKw => Token::ReturnedKw,
        FnegKw => Token::FnegKw,
        AsmKw => Token::AsmKw,
        BlockaddressKw => Token::BlockaddressKw,
        GcKw => Token::GcKw,
        PtrauthKw => Token::PtrauthKw,
        DefineLinkageKw => Token::DefineLinkageKw(<String>),
        DeclarePrefixMdKw => Token::DeclarePrefixMdKw(<String>),
        TypedPtrKw => Token::TypedPtrKw(<String>),
        Pipe => Token::Pipe,
        PrefixKw => Token::PrefixKw,
        PrologueKw => Token::PrologueKw,
        RiscvVlsCcKw => Token::RiscvVlsCcKw(<u32>),
        SplatKw => Token::SplatKw,
        DenormalFpenvKw => Token::DenormalFpenvKw(<String>),
        UselistorderBbKw => Token::UselistorderBbKw,
        PresplitKw => Token::PresplitKw,
        VconstOp => Token::VconstOp,
        Big => Token::Big,
        VecConstLit => Token::VecConstLit(<String>),
        ZeroInitKw => Token::ZeroInitKw,
        ZeroInitLit => Token::ZeroInitLit(<String>),
        VecZeroInitLit => Token::VecZeroInitLit(<String>),
        Sext => Token::Sext,
        Zext => Token::Zext,
        Trunc => Token::Trunc,
        Fptrunc => Token::Fptrunc,
        Fpext => Token::Fpext,
        Fptosi => Token::Fptosi,
        Sitofp => Token::Sitofp,
        Fptoui => Token::Fptoui,
        Uitofp => Token::Uitofp,
        Ptrtoint => Token::Ptrtoint,
        Inttoptr => Token::Inttoptr,
        Bitcast => Token::Bitcast,
        Phi => Token::Phi,
        To => Token::To,
        Ellipsis => Token::Ellipsis,
        AddrspaceCastKw => Token::AddrspaceCastKw,
        LandingPadKw => Token::LandingPadKw,
        InvokeKw => Token::InvokeKw,
        InallocaKw => Token::InallocaKw,
        ByrefKw => Token::ByrefKw,
        UwtableKw => Token::UwtableKw,
        BuiltinKw => Token::BuiltinKw,
        NobuiltinKw => Token::NobuiltinKw,
        CapturesKw => Token::CapturesKw,
        NosyncKw => Token::NosyncKw,
        ResumeKw => Token::ResumeKw,
        VaArgKw => Token::VaArgKw,
    }
}

// ── 顶层 ──

pub Module: ParsedModule = {
    <items: (<ModuleItem>)*> => ParsedModule {
        items,
        attr_groups: Default::default(),
    },
};

ModuleItem: ParsedItem = {
    <spec: TargetSpec> => ParsedItem::Target(spec.0, spec.1),
    // comdat 声明：`$c = comdat any`（kind 丢弃——ComdatKind::Any 等价，
    // 语义层按名去重；LLVM 先声明后引用）
    <n: ComdatName> Eq ComdatKw <_k: Ident> => ParsedItem::ComdatDecl(n),
    <FunctionDef> => ParsedItem::Function(<>),
    <DeclareDef> => ParsedItem::Function(<>),
    <g: GlobalDef> => ParsedItem::Global(g),
    // alias：`@a = [internal] alias <ty>, <aliasee>`（aliasee 为常量表达式）
    <name: GlobalId> Eq <links: LinkageSeq?> AliasKw <ty: Type> Comma <aliasee: ExprOperand> <metas: CommaAttach*> => ParsedItem::Alias(ParsedAlias {
        name: name,
        ty: ty,
        aliasee,
        linkage: links.as_ref().and_then(|l| l.0.clone()),
        visibility: links.as_ref().and_then(|l| l.4.clone()),
        dso_local: links.as_ref().map(|l| l.1).unwrap_or(false),
        unnamed_addr: links.as_ref().map(|l| l.2).unwrap_or(false),
        metadata: metas,
    }),
    // alias 带函数类型：`@f = alias void (), ptr @0`（anon-functions 类——函数
    // 类型仅解析不落 IR，ty 用返回类型）
    <name: GlobalId> Eq <links: LinkageSeq?> AliasKw <ret: Type> LParen <_params: ParamList> RParen Comma <aliasee: ExprOperand> <metas: CommaAttach*> => ParsedItem::Alias(ParsedAlias {
        name: name,
        ty: ret,
        aliasee,
        linkage: links.as_ref().and_then(|l| l.0.clone()),
        visibility: links.as_ref().and_then(|l| l.4.clone()),
        dso_local: links.as_ref().map(|l| l.1).unwrap_or(false),
        unnamed_addr: links.as_ref().map(|l| l.2).unwrap_or(false),
        metadata: metas,
    }),
    Attributes <id: AttrGroupId> Eq LBrace <attrs: FuncAttrs> RBrace => {
        ParsedItem::AttrGroup(id, attrs)
    },
    <id: MetadataIdKw> Eq <node: MetadataNodeDef> => ParsedItem::Metadata(id, node),
    // 命名 metadata 定义（LLVM：`!t = !{...}`）——lexer 已把 `!name =` 消歧为
    // MetadataDefKw（含等号），此处无需 Eq。
    <name: MetadataDefKw> <node: MetadataNodeDef> => ParsedItem::NamedMetadata(name, node),
    // uselistorder：`uselistorder <ty> <val>, { 1, 0 }` / `uselistorder_bb label %l, { 0, 1 }`
    // （LLVM use-list 顺序指令——解析后宽松丢弃；第十一轮）
    UselistorderKw <t: Type> <_v: Value> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        let name = match _v {
            Operand::Global(g) => g,
            Operand::Local(l) => l,
            other => format!("{other:?}"),
        };
        ParsedItem::UselistOrder(name, idx, t)
    },
    UselistorderBbKw <t: Type> <_v: Value> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        let name = match _v {
            Operand::Global(g) => g,
            Operand::Local(l) => l,
            other => format!("{other:?}"),
        };
        ParsedItem::UselistOrder(name, idx, t)
    },
    // 模块级元数据：`source_filename = "..."` / `module asm "..."`
    SourceFilenameKw Eq <s: StrLit> => ParsedItem::SourceFilename(s),
    ModuleAsmKw <s: StrLit> => ParsedItem::ModuleAsm(s),
    // summary 条目（`^N = ...`——原文保留,语义层校验）
    <s: SummaryKw> => ParsedItem::Summary(s),
    // LLVM 类型定义：`%struct.X = type { i32, i64 }` / `%p = type <{ i32 }>`（packed struct，现代语法）
    // S3.2 扩展：任意 ValueType（`%t = type [8 x i8]` 数组、`%t = type opaque` 等）
    <name: LocalId> Eq TypeKw <t: ValueType> => ParsedItem::TypeDef(name, t),
};

// metadata 节点：`!{...}` / `!named(...)`（`distinct` 前缀——去重语义丢弃，文本层等价；
// `metadata !{}` 旧语法由 MetadataKw 专用 token 拒绝——不匹配 Ident）
MetadataNodeDef: MetadataNodeDef = {
    <_d: Ident> <node: MetadataNodeDef> => MetadataNodeDef::Distinct(Box::new(node)),
    Bang LBrace <vals: MetadataValList> RBrace => MetadataNodeDef::Tuple(vals),
    <name: MetadataNameKw> LParen <vals: MetadataValList> RParen => MetadataNodeDef::Named(name, vals),
};

MetadataValList: Vec<MetadataVal> = {
    => vec![],
    <mut v: (<MetadataVal> Comma)*> <p: MetadataVal> =>? {
        v.push(p);
        Ok(v)
    }
};

MetadataVal: MetadataVal = {
    <n: IntLit> => match i64::try_from(n.clone()) {
        Ok(v) => MetadataVal::Int(v),
        Err(_) => MetadataVal::IntBig(n),
    },
    <n: HexLit> => MetadataVal::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    <f: FloatLit> => MetadataVal::Float(f),
    <s: StrLit> => MetadataVal::Str(s),
    // LLVM metadata 字符串：`!"hello"`（带 Bang）
    Bang <s: StrLit> => MetadataVal::Str(s),
    Null => MetadataVal::Null,
    <id: MetadataIdKw> => MetadataVal::Ref(id),
    // 命名节点引用（LLVM：`!{!t}`）——`!name (` 是 Named 节点定义，`!name` 后跟
    // `,`/`}`/`)` 是引用；LALR(1) 以 LParen 区分，无冲突。
    <name: MetadataNameKw> => MetadataVal::NamedRef(name),
    // 裸 Ident 参数（`!DIExpression(DW_OP_constu, 42, ...)`——DWARF 操作符；
    // 第十二轮）
    <n: Ident> => MetadataVal::Str(n),
    <node: MetadataNodeDef> => MetadataVal::Nested(Box::new(node)),
    // named 节点 key:value（LLVM：`!DILocation(line: 10)`）——key 携带
    // （第二十一轮：DI 批量校验用；build 后丢弃,IR 层值等价）；
    // `type:`/`align:` 等关键字 key（LLVM DI 节点常用——TypeKw/Align 非 Ident）。
    // value 用 MetadataValPrim（不含 Nested/key:value）——避免 LALR 状态膨胀
    //（`file: !2, scope: !3` 的 `!N` 数字引用需在 value 状态可转移）。
    <_key: Ident> Colon <v: MetadataValPrim> => MetadataVal::Field(_key, Box::new(v)),
    <_k: TypeKw> Colon <v: MetadataValPrim> => MetadataVal::Field("type".to_string(), Box::new(v)),
    <_k: Align> Colon <v: MetadataValPrim> => MetadataVal::Field("align".to_string(), Box::new(v)),
    <_k: Noundef> Colon <v: MetadataValPrim> => MetadataVal::Field("noundef".to_string(), Box::new(v)),
    <_k: UwtableKw> Colon <v: MetadataValPrim> => MetadataVal::Field("uwtable".to_string(), Box::new(v)),
    <_k: Cc> Colon <v: MetadataValPrim> => MetadataVal::Field("cc".to_string(), Box::new(v)),
    <_k: Attributes> Colon <v: MetadataValPrim> => MetadataVal::Field("attributes".to_string(), Box::new(v)),
    // `key: {!0, !3, !4}` 裸 tuple 整段（lexer 合并 token——
    // generic-debug-node.ll；第二十一轮）
    <t: MetadataFieldTupleLit> => {
        crate::ir_parser::ast_items::split_md_field_tuple_lit(&t)
    },
    // 类型化值（LLVM：`!{i32 1}` / `!{ptr null}`）——类型丢弃（内部值等价）
    <_ty: Type> <v: Value> => match v {
        Operand::Int(n) => MetadataVal::Int(n),
        Operand::UInt(n) => MetadataVal::UInt(n),
        Operand::Float(f) => MetadataVal::Float(f),
        Operand::Null => MetadataVal::Null,
        _ => MetadataVal::Str("value".to_string()),
    },
};

// key:value 的值子集（prim 值——无嵌套节点/嵌套 key:value）
MetadataValPrim: MetadataVal = {
    <n: IntLit> => match i64::try_from(n.clone()) {
        Ok(v) => MetadataVal::Int(v),
        Err(_) => MetadataVal::IntBig(n),
    },
    <n: HexLit> => MetadataVal::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    // Tuple 值（`operands: {!0, !3, !4}`——generic-debug-node.ll；裸 LBrace
    // grammar 分支与 Type 的匿名结构冲突,改 lexer 合并(裸 `{` 后跟 `!N`
    // 形态与非 metadata 语法不相交);第二十一轮
    Bang LBrace <vals: MetadataValList> RBrace => {
        MetadataVal::Nested(Box::new(MetadataNodeDef::Tuple(vals)))
    },
    <f: FloatLit> => MetadataVal::Float(f),
    <s: StrLit> => MetadataVal::Str(s),
    Bang <s: StrLit> => MetadataVal::Str(s),
    Null => MetadataVal::Null,
    <id: MetadataIdKw> => MetadataVal::Ref(id),
    // Named 节点值（`expr: !DIExpression(...)`——第十二轮：可空括号形态，
    // 避免 LR(1) 的 LParen 2-lookahead）
    <name: MetadataNameKw> <rest: (LParen MetadataValList RParen)?> => match rest {
        Some((_, vals, _)) => MetadataVal::Nested(Box::new(MetadataNodeDef::Named(name, vals))),
        None => MetadataVal::NamedRef(name),
    },
    True => MetadataVal::Int(1),
    False => MetadataVal::Int(0),
    // DWARF 枚举值（LLVM DI 节点：`language: DW_LANG_C99`）与 flag 组合
    // （`flags: DIFlag... | DIFlag...`——第十二轮）——存字符串
    <n: Ident> <rest: (Pipe Ident)*> => {
        if rest.is_empty() {
            MetadataVal::Str(n)
        } else {
            let mut s = n;
            for (_, r) in rest {
                s.push_str(" | ");
                s.push_str(&r);
            }
            MetadataVal::Str(s)
        }
    },
    // 类型化值（`type: i32 32`——第十二轮；类型丢弃）
    <_ty: Type> <v: Value> => match v {
        Operand::Int(n) => MetadataVal::Int(n),
        Operand::UInt(n) => MetadataVal::UInt(n),
        Operand::Float(f) => MetadataVal::Float(f),
        Operand::Null => MetadataVal::Null,
        _ => MetadataVal::Str("value".to_string()),
    },

};

// 函数/指令尾 metadata 附加：`!dbg !0` / `!dbg !t`（≥0 个；命名定义 `!t = ...`
// 由 lexer 消歧为 MetadataDefKw，不会误入本闭包；命名引用 `!t` 由 semantics
// 经 lookup_named 解析为数字 id）。
MetadataAttach: (String, MetadataRef) = {
    <name: MetadataNameKw> <id: MetadataIdKw> => (name, MetadataRef::Num(id)),
    <name: MetadataNameKw> <r: MetadataNameKw> => (name, MetadataRef::Named(r)),
};

// 指令级附加带逗号（LLVM：`..., !dbg !0`）；函数级无逗号
CommaAttach: (String, MetadataRef) = {
    Comma <m: MetadataAttach> => m,
};

// 全局类型 + 可选 zeroinitializer 的合并形式：lexer 把 `i32 zeroinitializer`
// 合成单 token ZeroInitLit（maximal munch）——GlobalDef 的 `<ty: Type>` 位置
// 收不到 IntTy，必须整 token 拆出类型与 ZeroInit init。
TypeAndInit: (ParsedType, Option<GlobalInitVal>) = {
    <t: Type> => (t, None),
    <lit: ZeroInitLit> => (crate::ir_parser::ast_items::split_scalar_ty(&lit), Some(GlobalInitVal::ZeroInit)),
    <lit: VecZeroInitLit> => (crate::ir_parser::ast_items::split_vec_const_lit(&lit).0, Some(GlobalInitVal::ZeroInit)),
};

// ── 全局变量：@g = global <ty> <init> [, align N] ──

GlobalDef: ParsedGlobal = {
    // ifunc（第十一轮 IfuncKw 专用 token）：`@f = [linkage] ifunc <retty> (<params>), ptr @resolver`
    <name: GlobalId> Eq <links: LinkageSeq?> IfuncKw <ret: Type> LParen <params: ParamList> RParen Comma <_r: TypeOp> <metas: CommaAttach*> => ParsedGlobal {
        name: name,
        is_constant: false,
        ty: ret,
        init: None,
        align: 0,
        linkage: links.as_ref().and_then(|l| l.0.clone()),
        dso_local: links.as_ref().map(|l| l.1).unwrap_or(false),
        unnamed_addr: links.as_ref().map(|l| l.2).unwrap_or(false),
        section: None,
        addr_space: 0,
        thread_local: false,
        visibility: links.as_ref().and_then(|l| l.4.clone()),
        comdat: None,
        dll_storage: None,
        metadata: metas,
        // ifunc IR 表示（第二十九轮重建:参数类型文本 + resolver 名）
        is_ifunc: true,
        ifunc_params: params
            .iter()
            .map(|(ty, _, _)| crate::ir_parser::ast_items::fmt_parsed_type(ty))
            .collect(),
        ifunc_resolver: match &_r.op {
            Operand::Global(g) => Some(g.clone()),
            _ => None,
        },
    },
    // ifunc（旧形态兜底）：`@name = ifunc <retty> (<params>), ptr @resolver`
    <name: GlobalId> Eq <kw: Ident> <ret: Type> LParen <params: ParamList> RParen Comma PtrTy <_r: GlobalId> => ParsedGlobal {
        name: name,
        is_constant: false,
        ty: ret,
        init: None,
        align: 0,
        linkage: None,
        dso_local: false,
        unnamed_addr: false,
        section: None,
        addr_space: 0,
        thread_local: false,
        visibility: None,
        comdat: None,
        dll_storage: None,
        metadata: vec![],
        is_ifunc: true,
        ifunc_params: params
            .iter()
            .map(|(ty, _, _)| crate::ir_parser::ast_items::fmt_parsed_type(ty))
            .collect(),
        ifunc_resolver: Some(_r),
    },
    // `global`（可变）/ `constant`（不可变）走 Ident——避免关键字遮蔽
    // global_addr 等以 global 开头的指令名；未知 kw 宽容视为可变 global
    <name: GlobalId> Eq <kw: Ident> <ti: TypeAndInit> <init: GlobalInit?> <tail: GlobalTail?> => ParsedGlobal {        name: name,
        is_constant: kw == "constant",
        ty: ti.0,
        // ti.1 为合并 token 携带的 ZeroInit init；None 时用 `<init: GlobalInit?>` 解析结果（如 `global i32 42`）
        init: ti.1.or(init),
        align: tail.as_ref().map(|t| t.0).unwrap_or(0),
        linkage: None,
        dso_local: false,
        unnamed_addr: false,
        section: tail.as_ref().and_then(|t| t.1.clone()),
        addr_space: 0,
        thread_local: false,
        visibility: None,
        comdat: tail.as_ref().and_then(|t| t.2.clone()),
        dll_storage: None,
        metadata: tail.as_ref().map(|t| t.3.clone()).unwrap_or_default(),
        is_ifunc: false,
        ifunc_params: vec![],
        ifunc_resolver: None,
    },
    // `global ptr [addrspace(N)] @ref` 裸引用 init（lexer 合并单 token——
    // L6 裸全局引用;`@B = global ptr @A` 形态,GlobalId 后 Eq vs 换行的
    // 2-lookahead 歧义经 lexer 消解;第二十一轮）
    <name: GlobalId> Eq <g: GlobalPtrInitKw> <tail: GlobalTail?> => {
        let (ty, target) = crate::ir_parser::ast_items::split_global_ptr_init(&g);
        ParsedGlobal {
            name: name,
            is_constant: false,
            ty,
            init: Some(GlobalInitVal::Expr(Box::new(
                crate::ir_parser::ast_items::ConstExpr::GlobalAddr(target),
            ))),
            align: tail.as_ref().map(|t| t.0).unwrap_or(0),
            linkage: None,
            dso_local: false,
            unnamed_addr: false,
            section: tail.as_ref().and_then(|t| t.1.clone()),
            addr_space: 0,
            thread_local: false,
            visibility: None,
            comdat: tail.as_ref().and_then(|t| t.2.clone()),
            is_ifunc: false,
            ifunc_params: vec![],
            ifunc_resolver: None,
            dll_storage: None,
            metadata: tail.as_ref().map(|t| t.3.clone()).unwrap_or_default(),
        }
    },
    <name: GlobalId> Eq <links: LinkageSeq> <kw: Ident> <ti: TypeAndInit> <init: GlobalInit?> <tail: GlobalTail?> => ParsedGlobal {
        name: name,
        is_constant: kw == "constant",
        ty: ti.0,
        // ti.1 为合并 token 携带的 ZeroInit init；None 时用 `<init: GlobalInit?>` 解析结果（如 `global i32 42`）
        init: ti.1.or(init),
        align: tail.as_ref().map(|t| t.0).unwrap_or(0),
        linkage: links.0,
        dso_local: links.1,
        unnamed_addr: links.2,
        thread_local: links.3,
        section: tail.as_ref().and_then(|t| t.1.clone()),
        is_ifunc: false,
        ifunc_params: vec![],
        ifunc_resolver: None,
        addr_space: 0,
        visibility: links.4,
        comdat: tail.as_ref().and_then(|t| t.2.clone()),
        dll_storage: links.5,
        metadata: tail.as_ref().map(|t| t.3.clone()).unwrap_or_default(),
    },
    // `addrspace(N)` 前缀（LLVM：`@g = addrspace(1) global i32 0`）
    <name: GlobalId> Eq <asp: GlobalAddrSpace> <kw: Ident> <ti: TypeAndInit> <init: GlobalInit?> <tail: GlobalTail?> => ParsedGlobal {
        name: name,
        is_constant: kw == "constant",
        ty: ti.0,
        // ti.1 为合并 token 携带的 ZeroInit init；None 时用 `<init: GlobalInit?>` 解析结果（如 `global i32 42`）
        init: ti.1.or(init),
        align: tail.as_ref().map(|t| t.0).unwrap_or(0),
        linkage: None,
        dso_local: false,
        is_ifunc: false,
        ifunc_params: vec![],
        ifunc_resolver: None,
        unnamed_addr: false,
        thread_local: false,
        section: tail.as_ref().and_then(|t| t.1.clone()),
        addr_space: asp,
        visibility: None,
        comdat: tail.as_ref().and_then(|t| t.2.clone()),
        dll_storage: None,
        metadata: tail.as_ref().map(|t| t.3.clone()).unwrap_or_default(),
    },
    <name: GlobalId> Eq <links: LinkageSeq> <asp: GlobalAddrSpace> <kw: Ident> <ti: TypeAndInit> <init: GlobalInit?> <tail: GlobalTail?> => ParsedGlobal {
        name: name,
        is_constant: kw == "constant",
        ty: ti.0,
        // ti.1 为合并 token 携带的 ZeroInit init；None 时用 `<init: GlobalInit?>` 解析结果（如 `global i32 42`）
        init: ti.1.or(init),
        is_ifunc: false,
        ifunc_params: vec![],
        ifunc_resolver: None,
        align: tail.as_ref().map(|t| t.0).unwrap_or(0),
        linkage: links.0,
        dso_local: links.1,
        unnamed_addr: links.2,
        thread_local: links.3,
        section: tail.as_ref().and_then(|t| t.1.clone()),
        addr_space: asp,
        visibility: links.4,
        comdat: tail.as_ref().and_then(|t| t.2.clone()),
        dll_storage: links.5,
        metadata: tail.as_ref().map(|t| t.3.clone()).unwrap_or_default(),
    },
};

// 地址空间值（数字或符号化字符串——符号化宽松 0）
AddrSpaceVal: i64 = {
    <n: IntLit> => crate::ir_parser::ast_items::big_as_i64(&n),
    <_s: StrLit> => 0,
    // 标识符形态（LLVM：addrspace(D)——平台符号化地址空间）
    <_i: Ident> => 0,
};

// 全局地址空间前缀：`addrspace(N)`
GlobalAddrSpace: u32 = {
    AddrspaceKw LParen <n: IntLit> RParen => crate::ir_parser::ast_items::big_as_u32(&n),
    // 符号化地址空间（LLVM：addrspace("G")——AArch64 等按名寻址）——宽松 0
    AddrspaceKw LParen <_s: StrLit> RParen => 0,
};

// 全局尾部属性：`, align N` / `, section "name"` / `, comdat($n)` / `, !kind !N`
// 任意顺序/数量——列表式（每项以 Comma 开头完整匹配；与 AllocaOpt 同模式防部分消费歧义）
GlobalTail: (u64, Option<String>, Option<String>, Vec<(String, MetadataRef)>) = {
    <opts: (GlobalTailOpt)+> => {
        let mut align = 0u64;
        let mut section = None;
        let mut comdat = None;
        let mut metas = Vec::new();
        for (kind, n, s, c, m) in opts {
            match kind.as_str() {
                "align" => align = n,
                "section" => section = s,
                "comdat" => comdat = c,
                "meta" => {
                    if let Some(m) = m {
                        metas.push(m);
                    }
                }
                _ => {}
            }
        }
        (align, section, comdat, metas)
    }
};

// 全局尾部单项（以 Comma 开头完整匹配）
GlobalTailOpt: (String, u64, Option<String>, Option<String>, Option<(String, MetadataRef)>) = {
    Comma Align <n: IntLit> => ("align".to_string(), crate::ir_parser::ast_items::big_as_u64(&n), None, None, None),
    Comma Section <s: StrLit> => ("section".to_string(), 0u64, Some(s), None, None),
    Comma ComdatKw LParen <c: ComdatName> RParen => ("comdat".to_string(), 0u64, None, Some(c), None),
    // 无括号 comdat（`constant [7 x i8] c"...", comdat, align 1`——第十五轮）
    Comma ComdatKw => ("comdat".to_string(), 0u64, None, None, None),
    Comma <m: MetadataAttach> => ("meta".to_string(), 0u64, None, None, Some(m)),
    // 关键字属性（`global i32 2, no_sanitize_address, align 4`）——宽松丢弃
    Comma <_k: Ident> => ("attr".to_string(), 0u64, None, None, None),
    // LLVM 全局字符串属性对：`"key" = "value"`（display 语义丢弃）
    Comma <_s1: StrLit> Eq <_s2: StrLit> => ("attr".to_string(), 0u64, None, None, None),
    // 无逗号形态（LLVM 新语法：`global i32 7 "key" = "value"`）
    <_s1: StrLit> Eq <_s2: StrLit> => ("attr".to_string(), 0u64, None, None, None),
    // 无逗号属性组引用（`global i32 2 #0`）——宽松丢弃
    <_g: AttrGroupId> => ("attrgroup".to_string(), 0u64, None, None, None),
    // 无值字符串属性（`global i32 0 "no_sanitize_address"`）
    <_s: StrLit> => ("attr".to_string(), 0u64, None, None, None),
};

// 全局符号前缀：`[dso_local] [thread_local] [unnamed_addr] [linkage] [vis] [dll]`（≥1 个）
// 6 维：link / dso / unnamed / tls / vis / dll——单闭包 + 语义分类（避免 (X)* X 闭包膨胀）
LinkageSeq: (Option<String>, bool, bool, bool, Option<String>, Option<String>) = {
    <ts: (<GlobalSymKw>)*> <f: GlobalSymKw> => {
        let mut dso = false;
        let mut unnamed = false;
        let mut tls = false;
        let mut link = None;
        let mut vis = None;
        let mut dll = None;
        for t in ts.into_iter().chain(std::iter::once(f)) {
            if t == "dso_local" {
                dso = true;
            } else if t == "unnamed_addr" || t == "local_unnamed_addr" {
                unnamed = true;
            } else if t == "thread_local" {
                tls = true;
            } else if t == "hidden" || t == "protected" {
                vis = Some(t);
            } else if t == "dllimport" || t == "dllexport" {
                dll = Some(t);
            } else {
                link = Some(t);
            }
        }
        (link, dso, unnamed, tls, vis, dll)
    },
};

// 全局符号关键字（单 token → 字符串；dso_local 或 linkage）
GlobalSymKw: String = {
    DsoLocal => "dso_local".to_string(),
    Private => "private".to_string(),
    Internal => "internal".to_string(),
    External => "external".to_string(),
    Weak => "weak".to_string(),
    WeakOdrKw => "weak_odr".to_string(),
    LinkonceKw => "linkonce".to_string(),
    LinkonceOdrKw => "linkonce_odr".to_string(),
    AppendingKw => "appending".to_string(),
    AvailableExternallyKw => "available_externally".to_string(),
    ExternWeakKw => "extern_weak".to_string(),
    ExternallyInitializedKw => "externally_initialized".to_string(),
    CommonKw => "common".to_string(),
    DllImportKw => "dllimport".to_string(),
    DllExportKw => "dllexport".to_string(),
    UnnamedAddrKw => "unnamed_addr".to_string(),
    LocalUnnamedAddrKw => "local_unnamed_addr".to_string(),
    ThreadLocalKw => "thread_local".to_string(),
    ThreadLocalModelKw => "thread_local".to_string(),
    HiddenKw => "hidden".to_string(),
    ProtectedKw => "protected".to_string(),
};

GlobalInit: GlobalInitVal = {
    <n: IntLit> => GlobalInitVal::Int(crate::ir_parser::ast_items::big_as_i64(&n)),
    <n: HexLit> => GlobalInitVal::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    <f: FloatLit> => GlobalInitVal::Float(f),
    <fh: HexFloatLit> => GlobalInitVal::Float(fh),
    <_fh: FloatHexLit> => GlobalInitVal::Float(0.0),
    Null => GlobalInitVal::Null,
    <c: CString> => GlobalInitVal::Str(
        crate::ir_parser::ast_items::decode_c_string(&c),
    ),
    <_z: ZeroInitLit> => GlobalInitVal::ZeroInit,
    <_z: VecZeroInitLit> => GlobalInitVal::ZeroInit,
    ZeroInitKw => GlobalInitVal::ZeroInit,
    // 注：裸全局引用 init（`@p = global ptr @h`）不可行——`global i32 @h` 与
    // `global i32\n@h = ...`（下一条模块级 global）在 LALR(1) 下 2-lookahead 歧义，
    // LLVM 自身靠上下文解析（见附录 §6 备忘）。带类型形式 `ptr @h` 走 GlobalConstExpr。
    // 常量表达式：`ptrtoint (ptr @h to i32)` / `getelementptr (i32, ptr @h, i64 0)`
    <e: GlobalConstExpr> => GlobalInitVal::Expr(Box::new(e)),
    // 带类型前缀的常量表达式：`<3 x x86_fp80> splat (...)`（类型忽略——表达式自身携带）
    <_ty: ValueType> <e: GlobalConstExpr> => GlobalInitVal::Expr(Box::new(e)),
    // 聚合常量：`[i32 1, i32 2, ...]`（数组）与 `{ i32 1, i64 2 }`（结构体）；空聚合 `{}`/`[]` 合法
    LBracket RBracket => GlobalInitVal::Agg(vec![]),
    LBracket <first: GlobalAggElem> <rest: (Comma <GlobalAggElem>)*> RBracket => {
        let mut v = vec![first];
        v.extend(rest);
        GlobalInitVal::Agg(v)
    },
    LBrace RBrace => GlobalInitVal::Agg(vec![]),
    LBrace <first: GlobalAggElem> <rest: (Comma <GlobalAggElem>)*> RBrace => {
        let mut v = vec![first];
        v.extend(rest);
        GlobalInitVal::Agg(v)
    },
    // packed struct：`<{ i32 7, i32 9 }>`
    LAngle LBrace RBrace RAngle => GlobalInitVal::Agg(vec![]),
    LAngle LBrace <first: GlobalAggElem> <rest: (Comma <GlobalAggElem>)*> RBrace RAngle => {
        let mut v = vec![first];
        v.extend(rest);
        GlobalInitVal::Agg(v)
    },
};

// 常量表达式转换操作（trunc/zext/sext——lexer 专用 token 已在 ConvOp 使用）
ConvCastOp: String = {
    Trunc => "trunc".to_string(),
    Zext => "zext".to_string(),
    Sext => "sext".to_string(),
};

// 常量表达式（3.3）：`<name> (<ty> <value> to <ty>)`（ptrtoint/inttoptr/bitcast/
// addrspacecast 是 lexer 专用 token；getelementptr 走 Ident）与
// `getelementptr (<indexed_ty>, <ty> <ptr>, <ty> <idx>, ...)`。
GlobalConstExpr: crate::ir_parser::ast_items::ConstExpr = {
    // 二元折叠表达式：`add nuw nsw (i64 <l>, i64 <r>)`（flags 可选；
    // 操作数带类型前缀或嵌套表达式——ExprOperand 双形态）
    <op: BinaryOp> <flags: InstFlagSeq> LParen <l: ExprOperand> Comma <r: ExprOperand> RParen => {
        crate::ir_parser::ast_items::ConstExpr::Binary {
            op,
            flags,
            lhs: Box::new(l.1),
            rhs: Box::new(r.1),
        }
    },
    // `splat (i1 true)`（LLVM 18+ splat 常量表达式——宽松折叠为 0）
    <_op: Ident> LParen <_e: ExprOperand> RParen => {
        crate::ir_parser::ast_items::ConstExpr::Unsupported("splat".to_string())
    },
    <op: BinaryOp> LParen <l: ExprOperand> Comma <r: ExprOperand> RParen => {
        crate::ir_parser::ast_items::ConstExpr::Binary {
            op,
            flags: vec![],
            lhs: Box::new(l.1),
            rhs: Box::new(r.1),
        }
    },
    // ptrauth（LLVM AArch64 指针认证：`ptrauth (ptr @var, i32 0)`——参数携带
    // 至语义层值级校验：base 指针类 / key i32 常量 / int_disc i64 常量 /
    // addr_disc 指针类；校验通过宽松求值 0。第十四轮多参数形态因负向漂移
    // 回滚（+2 = invalid-ptrauth-const3/4）——本轮语法四参数 + 值级校验配套）
    PtrauthKw LParen <_op: ExprOperand> Comma <_k: ExprOperand> RParen => crate::ir_parser::ast_items::ConstExpr::Ptrauth(vec![_op, _k]),
    PtrauthKw LParen <_op: ExprOperand> Comma <_k: ExprOperand> Comma <_d: ExprOperand> RParen => crate::ir_parser::ast_items::ConstExpr::Ptrauth(vec![_op, _k, _d]),
    PtrauthKw LParen <_op: ExprOperand> Comma <_k: ExprOperand> Comma <_d: ExprOperand> Comma <_a: ExprOperand> RParen => crate::ir_parser::ast_items::ConstExpr::Ptrauth(vec![_op, _k, _d, _a]),
    // blockaddress（`ptr blockaddress(@f, %label)`——宽松 0；第十六轮 pr119818）
    BlockaddressKw LParen <_f: GlobalId> Comma <_l: LocalId> RParen => crate::ir_parser::ast_items::ConstExpr::Int(0),
    // splat（LLVM：`splat (ptr null)`——向量广播常量；求值宽松 0）
    SplatKw LParen <_op: ExprOperand> RParen => crate::ir_parser::ast_items::ConstExpr::Vector(
        crate::ir_parser::ast_items::ParsedType::Vec(1, Box::new(crate::ir_parser::ast_items::ParsedType::Int(32))),
        vec![],
    ),
    Ptrtoint LParen <op: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::PtrToInt {
            op_ty: op.0,
            op: Box::new(op.1),
            to_ty,
        }
    },
    // ptrtoaddr（LLVM 新常量表达式：`ptrtoaddr (ptr @x to i64)`）——宽松同 ptrtoint
    PtrtoaddrKw LParen <op: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::PtrToInt {
            op_ty: op.0,
            op: Box::new(op.1),
            to_ty,
        }
    },
    // 转换折叠表达式：`trunc (i64 42 to i32)` / `zext (...) to i64` /
    // `sext (...) to ...`（Trunc/Zext/Sext 是 lexer 专用 token）
    <op: ConvCastOp> LParen <src: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::Cast {
            op,
            src_ty: src.0,
            src: Box::new(src.1),
            to: to_ty,
        }
    },
    Inttoptr LParen <op: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::IntToPtr {
            op_ty: op.0,
            op: Box::new(op.1),
            to_ty,
        }
    },
    Bitcast LParen <op: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::Bitcast {
            op_ty: op.0,
            op: Box::new(op.1),
            to_ty,
        }
    },
    AddrspaceCastKw LParen <op: ExprOperand> To <to_ty: ValueType> RParen => {
        crate::ir_parser::ast_items::ConstExpr::AddrSpaceCast {
            op_ty: op.0,
            op: Box::new(op.1),
            to_ty,
        }
    },
    GetElementPtr LParen <indexed_ty: Type> Comma <op: ExprOperand> <rest: (Comma <ExprOperand>)*> RParen => {
        crate::ir_parser::ast_items::ConstExpr::GetElementPtr {
            indexed_ty,
            op_ty: op.0,
            ptr: Box::new(op.1),
            indices: rest.into_iter().collect(),
        }
    },
    // `getelementptr inbounds (...)` / `getelementptr nuw inrange(-8, 16) (...)`
    //（M3 标志类：flags 解析后丢弃——与现有 Inbounds 变体行为一致）
    GetElementPtr <_flags: GepFlagSeq> LParen <indexed_ty: Type> Comma <op: ExprOperand> <rest: (Comma <ExprOperand>)*> RParen => {
        crate::ir_parser::ast_items::ConstExpr::GetElementPtr {
            indexed_ty,
            op_ty: op.0,
            ptr: Box::new(op.1),
            indices: rest.into_iter().collect(),
        }
    },
};

// 表达式操作数：`<ty> <value>`（叶子）或嵌套表达式（`bitcast (ptr @h to ptr)`，
// 自身带括号、无类型前缀——op_ty 用 Void 占位，display 按 op 类型判定输出）。
ExprOperand: (crate::ir_parser::ast_items::ParsedType, crate::ir_parser::ast_items::ConstExpr) = {
    <ty: ValueType> <v: ExprValue> => (ty, v),
    <e: GlobalConstExpr> => (
        crate::ir_parser::ast_items::ParsedType::Void,
        e,
    ),
    // 向量常量（lexer 合并单 token）：`<2 x i64> <i64 1, i64 1>`（GEP 向量索引）
    <lit: VecConstLit> => {
        let (ty, lanes) = crate::ir_parser::ast_items::split_vec_const_lit(&lit);
        let expr = crate::ir_parser::ast_items::ConstExpr::Vector(ty.clone(), lanes);
        (ty, expr)
    },
    // 向量 zeroinitializer（lexer 合并单 token）：`<2 x ptr> zeroinitializer`
    <lit: VecZeroInitLit> => {
        let ty = crate::ir_parser::ast_items::split_vec_const_lit(&lit).0;
        let expr = crate::ir_parser::ast_items::ConstExpr::Vector(ty.clone(), vec![]);
        (ty, expr)
    },
};

ExprValue: crate::ir_parser::ast_items::ConstExpr = {
    <g: GlobalId> => crate::ir_parser::ast_items::ConstExpr::GlobalAddr(
        g.trim_start_matches('@').to_string(),
    ),
    <n: IntLit> => crate::ir_parser::ast_items::ConstExpr::Int(crate::ir_parser::ast_items::big_as_i64(&n)),
    <n: HexLit> => crate::ir_parser::ast_items::ConstExpr::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    // 浮点十六进制位模式（宽松 0）
    <_n: FloatHexLit> => crate::ir_parser::ast_items::ConstExpr::UInt(0),
    <f: FloatLit> => crate::ir_parser::ast_items::ConstExpr::Float(f),
    True => crate::ir_parser::ast_items::ConstExpr::Int(1),
    False => crate::ir_parser::ast_items::ConstExpr::Int(0),
    Null => crate::ir_parser::ast_items::ConstExpr::Null,
    Undef => crate::ir_parser::ast_items::ConstExpr::Undef,
    Poison => crate::ir_parser::ast_items::ConstExpr::Poison,
    // 嵌套表达式：`bitcast (ptr @h to ptr)` 作为操作数（括号包裹）
    LParen <e: GlobalConstExpr> RParen => e,
    // 向量常量（常量表达式位置）：`<2 x i32> <i32 3, i32 4>`
    <lit: VecConstLit> => {
        let (ty, lanes) = crate::ir_parser::ast_items::split_vec_const_lit(&lit);
        crate::ir_parser::ast_items::ConstExpr::Vector(ty, lanes)
    },
    // 嵌套二元折叠表达式（带类型前缀的 ExprOperand 值位置）：
    // `i64 add (i64 <l>, i64 <r>)`——`<ty: ValueType> <v: ExprValue>` 中
    // ValueType 后 lookahead ∈ BinaryOp first（LParen 分支已处理括号形态）
    <e: GlobalConstExpr> => e,
};

// 聚合常量元素：带类型标量字面量（`i32 1` / `float 1.5` / `ptr null`）
GlobalAggElem: GlobalInitVal = {
    <t: TypeOp> => match t.op {
        Operand::Int(n) => GlobalInitVal::Int(n),
        Operand::UInt(n) => GlobalInitVal::UInt(n),
        Operand::Float(f) => GlobalInitVal::Float(f),
        Operand::Null => GlobalInitVal::Null,
        // 嵌套聚合（`[4 x ptr] [ptr null, ...]`——带类型前缀的嵌套 init；
        // 第十一轮 vtable 摘要类）：Agg 透传，元素递归转换
        Operand::Agg(v) => {
            fn conv(p: crate::ir_parser::ast_items::ParsedOperand) -> GlobalInitVal {
                match p.op {
                    Operand::Int(n) => GlobalInitVal::Int(n),
                    Operand::UInt(n) => GlobalInitVal::UInt(n),
                    Operand::Float(f) => GlobalInitVal::Float(f),
                    Operand::Null | Operand::Undef | Operand::Poison => GlobalInitVal::Null,
                    Operand::Agg(v) => GlobalInitVal::Agg(v.into_iter().map(conv).collect()),
                    _ => GlobalInitVal::Int(0),
                }
            }
            GlobalInitVal::Agg(v.into_iter().map(conv).collect())
        }
        _ => GlobalInitVal::Int(0),
    },
    // 嵌套聚合元素（LLVM：`[[i32 1, i32 2], [i32 3, i32 4]]` / `{{i32 1}, i32 2}`；
    // 内层类型从外层聚合推导——GlobalAggElem 递归，无左递归）
    LBracket <first: GlobalAggElem> <rest: (Comma <GlobalAggElem>)*> RBracket => {
        let mut v = vec![first];
        v.extend(rest);
        GlobalInitVal::Agg(v)
    },
    LBrace <first: GlobalAggElem> <rest: (Comma <GlobalAggElem>)*> RBrace => {
        let mut v = vec![first];
        v.extend(rest);
        GlobalInitVal::Agg(v)
    },
};


AlignOpt: u32 = {
    Comma Align <n: IntLit> => crate::ir_parser::ast_items::big_as_u32(&n),
};

TargetSpec: (String, String) = {
    Target Triple Eq <s: StrLit> => ("triple".to_string(), s),
    Target Datalayout Eq <s: StrLit> => ("datalayout".to_string(), s),
};

// ── 函数 ──

FunctionDef: ParsedFunction = {
    // define dso_local（clang 默认输出）：非抢占保证
    Define DsoLocal <fr: FuncRet> <name: GlobalId> LParen <params: ParamList> RParen <attrs: FuncAttrs?> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: fr.2,
        ret_attrs: fr.1,
        metadata: metas,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: true,
        call_conv: fr.0,
        attrs: {
            let mut a = attrs.unwrap_or_default();
            if let Some(g) = grp {
                a.push(format!("#{g}"));
            }
            a
        },
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
    Define DsoLocal <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <attrs: FuncAttrs?> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: true,
        call_conv: None,
        attrs: {
            let mut a = attrs.unwrap_or_default();
            if let Some(g) = grp {
                a.push(format!("#{g}"));
            }
            a
        },
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: metas,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
    Define <fr: FuncRet> <name: GlobalId> LParen <params: ParamList> RParen <_addrsp: (AddrspaceKw LParen AddrSpaceVal RParen)?> <attrs: FuncAttrs?> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: fr.2,
        ret_attrs: fr.1,
        metadata: metas,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: false,
        call_conv: fr.0,
        attrs: {
            let mut a = attrs.unwrap_or_default();
            if let Some(g) = grp {
                a.push(format!("#{g}"));
            }
            a
        },
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
    // define linkage（第十五轮 lexer 合并单 token——`define internal`）
    DefineLinkageKw <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <_addrsp: (AddrspaceKw LParen AddrSpaceVal RParen)?> <attrs: FuncAttrs?> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: false,
        call_conv: None,
        attrs: {
            let mut a = attrs.unwrap_or_default();
            if let Some(g) = grp {
                a.push(format!("#{g}"));
            }
            a
        },
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: metas,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
    Define <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <_addrsp: (AddrspaceKw LParen AddrSpaceVal RParen)?> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: false,
        call_conv: None,
        attrs: grp.map(|g| vec![format!("#{g}")]).unwrap_or_default(),
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: metas,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
    Define <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <attrs: FuncAttrs> <grp: AttrGroupId?> <_pre: (PrefixKw TypeOp)?> <_pro: (PrologueKw TypeOp)?> <_gc: (GcKw StrLit)?> <pers: Personality?> <comdat: ComdatOpt?> <metas: MetadataAttach*> <body: Body> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: body,
        declare: false,
        dso_local: false,
        call_conv: None,
        attrs: {
            let mut a = attrs;
            if let Some(g) = grp {
                a.push(format!("#{g}"));
            }
            a
        },
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: metas,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: pers,
        comdat: comdat.flatten(),
    },
};

// define 尾 comdat 子句（第十七轮：comdat $name 或裸 comdat {）
// Some(name) = 有名；Some("") = 裸 comdat 无名形态（数字函数名语义层拒绝）
ComdatOpt: Option<String> = {
    ComdatKw <n: ComdatName> => Some(n),
    // 裸 comdat（无名——LLVM 合法；第十七轮双分支实测 +1 漂移超限回滚,
    // 第二十轮误接受基线 71,+1 → 72 在断言上限 80 内；语义层校验
    // unnamed-comdat 负向形态）
    ComdatKw => Some(String::new()),
};

// visibility 前缀关键字（declare hidden/protected——第十一轮）
VisibilityKw: () = {
    HiddenKw => (),
    ProtectedKw => (),
};

DeclareDef: ParsedFunction = {
    // declare hidden/protected（visibility 前缀——第十一轮）
    Declare <_v: VisibilityKw> <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: ret,
        ret_attrs: vec![],
        metadata: tail.1,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: false,
        call_conv: None,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
    // declare dso_local：LLVM 允许 dso_local 前缀（非抢占声明）
        Declare DsoLocal <fr: FuncRet> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: fr.2,
        ret_attrs: fr.1,
        metadata: tail.1,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: true,
        call_conv: fr.0,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
        Declare DsoLocal <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: true,
        call_conv: None,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: tail.1,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
        Declare <fr: FuncRet> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: fr.2,
        ret_attrs: fr.1,
        metadata: tail.1,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: false,
        call_conv: fr.0,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
        Declare <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: false,
        call_conv: None,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: tail.1,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
    // declare !name !N 前缀 metadata（`declare !bar !1 void @bar()`——
    // LLVM 已弃用的 callee-type 前缀语法；lexer 合并单 token 消歧,
    // 前缀宽松丢弃）
    DeclarePrefixMdKw <ret: Type> <name: GlobalId> LParen <params: ParamList> RParen <tail: DeclareTail> => ParsedFunction {
        name: name,
        ret_ty: ret,
        params: params.iter().map(|(t, n, _)| (t.clone(), n.clone())).collect(),
        blocks: vec![],
        declare: true,
        dso_local: false,
        call_conv: None,
        attrs: tail.0,
        param_attrs: params.iter().map(|(_, _, a)| a.clone()).collect(),
        ret_attrs: vec![],
        metadata: tail.1,
        varargs: params.iter().any(|(_, n, _)| n == "..."),
        personality: None,
        comdat: None,
    },
};

// declare 尾部：`[FuncAttrs] [#N] [MetadataAttach*]`（**必选**单非终结符——第 6 轮
// 实测可空 DeclareTail? 与裸分支共存必冲突；空分支内含 `=> (vec![], vec![])`）。
// 返回 (attrs, metas)：`#N` 以 `#{n}` 字符串保存，build_module 阶段经属性组展开。
DeclareTail: (Vec<String>, Vec<(String, MetadataRef)>) = {
    <metas: MetadataAttach*> => (vec![], metas),
    <attrs: FuncAttrs> <metas: MetadataAttach*> => (attrs, metas),
    <attrs: FuncAttrs> <g: AttrGroupId> <metas: MetadataAttach*> => {
        let mut a = attrs;
        a.push(format!("#{g}"));
        (a, metas)
    },
    <g: AttrGroupId> <metas: MetadataAttach*> => (vec![format!("#{g}")], metas),
};

// 返回类型前缀：`[fastcc] [signext|zeroext|...]` + 返回类型（≥1 个关键字；
// LLVM：`define signext i8 @g`）。显式分支规避 (X)* 与 Type 的 LR 冲突。
FuncRet: (Option<String>, Vec<String>, ParsedType) = {
    <ts: (<FuncRetKw>)*> <f: FuncRetKw> <ret: Type> => {
        let mut cc = None;
        let mut attrs = vec![];
        for t in ts.into_iter().chain(std::iter::once(f)) {
            if t == "fastcc" || t == "win64cc" {
                cc = Some(t);
            } else {
                attrs.push(t);
            }
        }
        (cc, attrs, ret)
    },
    // 数值调用约定：`cc 10`（LLVM 标准）
    Cc <n: IntLit> <ret: Type> => (Some(format!("cc {n}")), vec![], ret),
    // 命名调用约定（LLVM：`declare amdgpu_cs_chain void @f()` /
    // `define amdgpu_ps void @g()`——amdgpu_* 等平台约定走 Ident）
    <kw: Ident> <ret: Type> => (Some(kw), vec![], ret),
    // riscv_vls_cc(N)（第十二轮：RISC-V 可伸缩向量约定——数值参数）
    <v: RiscvVlsCcKw> <ret: Type> => (Some(format!("riscv_vls_cc({v})")), vec![], ret),
};

FuncRetKw: String = {
    Fastcc => "fastcc".to_string(),
    Win64cc => "win64cc".to_string(),
        <v: ParenAttrKw> => v,
    ReturnedKw => "returned".to_string(),
    Signext => "signext".to_string(),
    Zeroext => "zeroext".to_string(),
    Noalias => "noalias".to_string(),
    Noundef => "noundef".to_string(),
    Readonly => "readonly".to_string(),
    Writeonly => "writeonly".to_string(),
    Nonnull => "nonnull".to_string(),
    InregKw => "inreg".to_string(),
    Align <n: IntLit> => format!("align {n}"),
    ByvalKw LParen <t: Type> RParen => format!("byval({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    SretKw LParen <t: Type> RParen => format!("sret({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    // captures(<mode>, <mode>...)：LLVM 参数捕获属性（none/address/provenance
    // ——开放值列表）
    CapturesKw LParen <v: CapturesVal> <rest: (Comma CapturesVal)*> RParen => {
        let mut parts = vec![v];
        for (_, r) in rest {
            parts.push(r);
        }
        format!("captures({})", parts.join(", "))
    },
    // byref 必须带类型参数（LLVM：`ptr byref(i32)`——裸 byref 拒绝，见 §7）
    ByrefKw LParen <t: Type> RParen => format!("byref({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    // dereferenceable(N)/dereferenceable_or_null(N)（第十一轮专用 token——
    // Ident 开放形态与命名调用约定 `Ident <ret: Type>` 的 LParen 闭包冲突）
    DereferenceableKw LParen <n: IntLit> RParen => format!("dereferenceable({n})"),
    DereferenceableOrNullKw LParen <n: IntLit> RParen => format!("dereferenceable_or_null({n})"),
};

// captures 的值：LLVM 开放模式集合（none/address/read/ret/provenance/...）
// ——Ident 兜底 + 与 lexer 关键字冲突的常用值（ret）
CapturesVal: String = {
    <v: Ident> => v,
    Ret => "ret".to_string(),
    // `none`（LLVM captures(none)——NoneKw 是 token 字面量专用 token）
    NoneKw => "none".to_string(),
    // 限定模式（LLVM 新语法）：`ret: address` / `read: provenance` 等
    <m: Ident> Colon <v: Ident> => format!("{m}:{v}"),
    Ret Colon <v: Ident> => format!("ret:{v}"),
    Ret Colon NoneKw => "ret:none".to_string(),
    NoneKw Colon <v: Ident> => format!("none:{v}"),
};

// 函数属性列表（LLVM 位置在参数列表后、body 前）：`nounwind noinline optnone ...`
FuncAttrs: Vec<String> = {
    <mut v: (<FuncAttr>)*> <f: FuncAttr> => {
        v.push(f);
        v
    },
};

FuncAttr: String = {
    UnnamedAddrKw => "unnamed_addr".to_string(),
    LocalUnnamedAddrKw => "local_unnamed_addr".to_string(),
    Align <n: IntLit> => format!("align {n}"),
    SspKw => "ssp".to_string(),
    ConvergentKw => "convergent".to_string(),
    StrictfpKw => "strictfp".to_string(),
    <v: FuncOpenAttrKw> => v,
    // range(...)/nofpclass(...)/memory(...)（payload 原样保 roundtrip）
    <v: ParenAttrKw> => v,
    // 保留完整文本含模式(第二十九轮重建:原固定名丢 (ieee) 致 display 还原缺参)
    <v: DenormalFpenvKw> => v,
    // 字符串属性对（属性组内：`"string" = "value"`）——原样保存
    <_k: StrLit> Eq <_v: StrLit> => format!("{_k} = {_v}"),
    Nounwind => "nounwind".to_string(),
    Noinline => "noinline".to_string(),
    Alwaysinline => "alwaysinline".to_string(),
    Norecurse => "norecurse".to_string(),
    Optnone => "optnone".to_string(),
    // 高频函数属性（Ident 兜底会引入 LALR 歧义——用专用 token）
    UwtableKw => "uwtable".to_string(),
    NosyncKw => "nosync".to_string(),
    BuiltinKw => "builtin".to_string(),
    NobuiltinKw => "nobuiltin".to_string(),
    // declare/define 尾部函数属性（LLVM：`declare ... nounwind readonly`）
    Readonly => "readonly".to_string(),
    Writeonly => "writeonly".to_string(),
    PresplitKw => "presplitcoroutine".to_string(),
};

Param: (ParsedType, String, Vec<String>) = {
    <ty: Type> <name: LocalId> => (ty, name, vec![]),
    <ty: Type> <attrs: ParamAttrs> <name: LocalId> => (ty, name, attrs),
    // 无名参数（LLVM：`declare i32 @f(i32, ptr)` 常见；define 亦可，函数体无法引用）
    <ty: Type> <attrs: ParamAttrs?> => (ty, "".to_string(), attrs.unwrap_or_default()),
    // 可变参数（LLVM：`declare i32 @printf(ptr, ...)`）——并入 Param 避免
    // ParamList 闭包在 Comma 处的 2-lookahead 歧义（`i32 %a, ...` 中 `...`
    // 是最后一个 Param，而非独立尾部）；名字用 `...` 哨兵，semantics 过滤。
    Ellipsis => (ParsedType::Void, "...".to_string(), vec![]),
};

// 参数属性：`signext`/`zeroext`/`noalias`/`noundef`/`readonly`/`writeonly`/`nocapture`/`nonnull`
//（LLVM 位置：类型后、参数名前；至少 1 个——显式分支避免可空 LR 歧义）
ParamAttrs: Vec<String> = {
    <mut v: (<ParamAttr>)*> <f: ParamAttr> => {
        v.push(f);
        v
    },
};

ParamAttr: String = {
    // 字符串参数属性（`i64 "foo bar"`——第十五轮 incorrect-tdep；带引号存
    // 以便语义层识别为字符串属性宽松）
    <sv: StrLit> => format!("\"{sv}\""),
    <v: ParenAttrKw> => v,
    ReturnedKw => "returned".to_string(),
    Signext => "signext".to_string(),
    ImmargKw => "immarg".to_string(),
    Zeroext => "zeroext".to_string(),
    Noalias => "noalias".to_string(),
    Noundef => "noundef".to_string(),
    Readonly => "readonly".to_string(),
    Writeonly => "writeonly".to_string(),
    Nocapture => "nocapture".to_string(),
    Nonnull => "nonnull".to_string(),
    InregKw => "inreg".to_string(),
    Align <n: IntLit> => format!("align {n}"),
    // LLVM 别名语法：`align(N)` 等价 `align N`（display 规范化为 `align N`）
    Align LParen <n: IntLit> RParen => format!("align {n}"),
    // 类型参数属性（LLVM：`byval(%struct.S)` / `sret(%struct.S)`）——
    // 类型经 fmt_parsed_type 序列化为文本，semantics 解析回 TypeId。
    ByvalKw LParen <t: Type> RParen => format!("byval({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    SretKw LParen <t: Type> RParen => format!("sret({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    // captures(<mode>, <mode>...)：LLVM 参数捕获属性（none/address/provenance
    // ——开放值列表）
    CapturesKw LParen <v: CapturesVal> <rest: (Comma CapturesVal)*> RParen => {
        let mut parts = vec![v];
        for (_, r) in rest {
            parts.push(r);
        }
        format!("captures({})", parts.join(", "))
    },
    // byref 必须带类型参数（LLVM：`ptr byref(i32)`——裸 byref 拒绝，见 §7）
    ByrefKw LParen <t: Type> RParen => format!("byref({})", crate::ir_parser::ast_items::fmt_parsed_type(&t)),
    // dereferenceable(N)/dereferenceable_or_null(N)（第十一轮专用 token——
    // Ident 开放形态与命名调用约定 `Ident <ret: Type>` 的 LParen 闭包冲突）
    DereferenceableKw LParen <n: IntLit> RParen => format!("dereferenceable({n})"),
    DereferenceableOrNullKw LParen <n: IntLit> RParen => format!("dereferenceable_or_null({n})"),
};

ParamList: Vec<(ParsedType, String, Vec<String>)> = {
    => vec![],
    // 左递归累积（替代右递归 vec![first] + extend 的 O(n²) reducer）
    <mut v: (<Param> Comma)*> <p: Param> =>? {
        v.push(p);
        Ok(v)
    }
};

// uselistorder 语句（终结符后允许；LLVM use-list 特例）——(值名, 索引) 收集
UselistorderStmt: (String, Vec<i64>, ParsedType) = {
    UselistorderKw <t: Type> <_v: Value> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        let name = match _v {
            Operand::Global(g) => g,
            Operand::Local(l) => l,
            other => format!("{other:?}"),
        };
        (name, idx, t)
    },
    UselistorderKw LabelTy <_v: LocalId> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        (_v, idx, ParsedType::Void)
    },
    UselistorderBbKw <t: Type> <_v: Value> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        let name = match _v {
            Operand::Global(g) => g,
            Operand::Local(l) => l,
            other => format!("{other:?}"),
        };
        (name, idx, t)
    },
    UselistorderBbKw LabelTy <_v: LocalId> Comma LBrace <_first: IntLit> <_rest: (Comma IntLit)*> RBrace => {
        let idx = crate::ir_parser::ast_items::collect_uselistorder_idx(&_first, _rest);
        
        (_v, idx, ParsedType::Void)
    },
};

Body: Vec<ParsedBlock> = {
    LBrace <blocks: (<Block>)*> RBrace => blocks,
};

// ── 块 ──

Block: ParsedBlock = {
    <label: BlockLabel> Colon <insts: (<Inst>)*> <term: Terminator> <tail: (UselistorderStmt)*> => ParsedBlock {
        label: label.0,
        label_is_num: label.1,
        implicit: false,
        insts: insts,
        terminator: term,
        uselistorders: tail,
    },
    // LLVM 合法语法：入口块可省略 label（`define void @f() { %a = ... }`）
    <insts: (<Inst>)*> <term: Terminator> <tail: (UselistorderStmt)*> => ParsedBlock {
        label: "entry".to_string(),
        uselistorders: tail,
        label_is_num: false,
        implicit: true,
        insts: insts,
        terminator: term,
    },
};

// 块 label：`%name`（LocalId）或裸名 `name`（LLVM 均合法；裸名走 Ident）
// 返回 (名字, 是否显式数字标签)：`3:` → ("3", true)；`"2":`/`-3:`/`$N:`
// → 字符串名（解码后可能呈数字形态但 is_num=false）。
BlockLabel: (String, bool) = {
    <n: LocalId> => {
        // `%"2":` 带引号形态 → 去引号解码（与 LabelRef 一致）
        let raw = n.trim_start_matches('%');
        if raw.starts_with('"') && raw.ends_with('"') && raw.len() >= 2 {
            (
                String::from_utf8_lossy(&crate::ir_parser::ast_items::decode_c_string(
                    &raw[1..raw.len() - 1].to_string(),
                ))
                .into_owned(),
                false,
            )
        } else {
            (raw.to_string(), false)
        }
    },
    <n: Ident> => (n, false),
    // 数字块标签（LLVM：`3:` 显式数字标签）
    <n: IntLit> => (n.to_string(), true),
    // 字符串标签（LLVM：`%"2":` / `"-3":` 带引号标签）
    <s: StrLit> => (s, false),
    // 数字型字符串标签（LLVM：`-N-:`——`-` 开头无引号）
    <s: LabelStr> => (s, false),
    // `$` 前缀字符串标签（LLVM：`$N:`——lexer 产出 ComdatName token；
    // 标签名保留 `$`（`br label %$N` 跳向 `$N:`））
    <c: ComdatName> => (c, false),
};


// ── 指令 ──

Inst: ParsedInst = {
    <res: LocalId> Eq <body: InstBody> => body.with_result(res),
    <body: InstBody> => body,
};

InstBody: ParsedInst = {
    // #dbg_* debug record 参数形态校验（第二十一轮——终结符后无位置自动
    // 拒绝 dbg-record-invalid-0;未知类型 lexer 拒绝 invalid-4;第 2/4 参
    // 必须 !ref 拒绝 invalid-2/6;参数计数拒绝 invalid-7/8）
    DbgValueKw LParen <_a: DbgArg> Comma <_b: MdRef> Comma <_c: DbgArg> Comma <_d: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    DbgDeclareKw LParen <_a: DbgArg> Comma <_b: MdRef> Comma <_c: DbgArg> Comma <_d: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    DbgDeclareValueKw LParen <_a: DbgArg> Comma <_b: MdRef> Comma <_c: DbgArg> Comma <_d: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    DbgLabelKw LParen <_a: DbgArg> Comma <_b: MdRef> Comma <_c: DbgArg> Comma <_d: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    // dbg_assign:7 参（value, !value_md, !expr, !id, addr, !expr, !loc——
    // metadata-use-uselistorder.ll 的完整形态）
    DbgAssignKw LParen <_a: DbgArg> Comma <_b: MdRef> Comma <_c: DbgArg> Comma <_d: MdRef> Comma <_e: DbgArg> Comma <_f: DbgArg> Comma <_g: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    // dbg_kill:2 参（value, !loc）
    DbgKillKw LParen <_a: DbgArg> Comma <_b: MdRef> RParen => crate::ir_parser::ast_items::dbg_record_inst(),
    // fneg（LLVM 浮点取负：`fneg fast <3 x float> %vec`）
    FnegKw <flags: InstFlagSeq> <t: Type> <v: Value> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: flags,
        result: None,
        opcode: "fneg".to_string(),
        cond: None,
        phi_incomings: vec![],
        args: vec![ParsedOperand { ty: t, op: v }],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
    },
    FnegKw <t: Type> <v: Value> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "fneg".to_string(),
        cond: None,
        phi_incomings: vec![],
        args: vec![ParsedOperand { ty: t, op: v }],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
    },
    // 比较（带条件）：icmp <cond> <ty> <a>, <ty> <b> [, !prof !N]
    // CmpOps 固定 2 操作数 + CommaAttach——TypeOps 闭包 `(TypeOp Comma)*` 吃不下
    // 尾逗号 `, !prof`（2-lookahead：Comma 后是 TypeOp 还是 MetadataNameKw）。
    <op: CompareOp> <cond: Ident> <args: CmpOps> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: Some(cond.to_string()),
        args: args.0,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: args.1,
        flags: vec![],
    },
    // `icmp samesign ult i32 %a, %b`（M3 标志类——samesign 在 cond 前）
    <op: CompareOp> Samesign <cond: Ident> <args: CmpOps> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: Some(cond.to_string()),
        args: args.0,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: args.1,
        flags: vec!["samesign".to_string()],
    },
    // 二元指令（S2）：`add nsw i32 %a, %b` / `add i32 %a, %b`（LLVM 现代
    // 语法第二操作数无类型——类型从第一推导，BinaryOps 处理）。专用
    // BinaryOp token 集使 first 与 Ident 通用规则分离；flags 可选
    // （InstFlagSeq 非空 vs 直接类型，first 集不相交）。
    <op: BinaryOp> <flags: InstFlagSeq> <args: BinaryOps> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: None,
        args: args.0,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: args.1,
        flags: flags,
    },
    <op: BinaryOp> <args: BinaryOps> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: None,
        args: args.0,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: args.1,
        flags: vec![],
    },
    // extractelement <vecty> <v>, <idx> / insertelement <vecty> <v>, <elemty> <x>, <idx>
    // shufflevector <vecty> <a>, <vecty> <b>, <mask>
    //（idx 常量存 immediates；shuffle 掩码用 MaskVecLit 单 token）
    ExtractElementKw <v: TypeOp> Comma <idx: TypeOp> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "extractelement".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![v, idx],
    },
    InsertElementKw <v: TypeOp> Comma <x: TypeOp> Comma <idx: TypeOp> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "insertelement".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![v, x, idx],
    },
    // 掩码：VecConstLit（`<4 x i32> <i32 0, ...>` 合并 token）或 MaskVecLit
    // （`<i32 0, ...>`——类型固定 i32 向量，semantics 只取 lane 值）
    ShuffleVectorKw <a: TypeOp> Comma <b: TypeOp> Comma <mask: MaskOrConst> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![mask],
        result: None,
        opcode: "shufflevector".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![a, b, ParsedOperand { ty: ParsedType::Vec(4, Box::new(ParsedType::Int(32))), op: Operand::VecConst(vec![]) }],
    },
    // extractvalue <aggty> <agg>, <idx> / insertvalue <aggty> <agg>, <elemty> <elem>, <idx>
    //（idx 是裸整数——通用 TypeOp 分支无法解析）
    ExtractValueKw <aggty: Type> <aggv: Value> Comma <idx: IntLit> <rest: (Comma IntLit)*> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "extractvalue".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: {
            let mut v = vec![
                ParsedOperand { ty: aggty, op: aggv },
                ParsedOperand { ty: ParsedType::Int(32), op: Operand::Int(crate::ir_parser::ast_items::big_as_i64(&idx)) },
            ];
            for (_, n) in rest {
                v.push(ParsedOperand { ty: ParsedType::Int(32), op: Operand::Int(crate::ir_parser::ast_items::big_as_i64(&n)) });
            }
            v
        },
    },
    // va_arg <ptrty> <ptr>, <ty>（LLVM 可变参数读取；ty 为返回类型占位——
    // ABI 布局为 P1，文本层把 (ty, undef) 占位存为第二个操作数）
    VaArgKw <ap: TypeOp> Comma <ty: ValueType> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "va_arg".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![
            ap,
            ParsedOperand { ty: ty, op: Operand::Undef },
        ],
    },
    InsertValueKw <aggty: Type> <aggv: Value> Comma <elem: TypeOp> Comma <idx: IntLit> <rest: (Comma IntLit)*> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "insertvalue".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![
            ParsedOperand { ty: aggty, op: aggv },
            elem,
            ParsedOperand { ty: ParsedType::Int(32), op: Operand::Int(crate::ir_parser::ast_items::big_as_i64(&idx)) },
        ],
    },
    // 原子指令（LLVM 语法）：
    //   atomicrmw add <ty> <ptr>, <ty> <val> <memord>（ptr 在逗号前）
    //   cmpxchg [weak] <ty> <ptr>, <ty> <cmp>, <ty> <new> <succ> <fail>
    //   fence <memord>
    // 操作名：S2 起 add/sub/and/or/xor/fadd/fsub 是专用 token（BinaryOp），
    // 其余（xchg/max/min/nand/...）仍走 Ident——AtomicOp 合并两者。
    AtomicRmwKw Volatile <_e: ElementwiseKw?> <op: AtomicOp> <ptr: TypeOp> Comma <val: TypeOp> <_sync: SyncScope?> <ord: Ident> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: true,
        align: 0,
        flags: vec![op, ord],
        result: None,
        opcode: "atomicrmw".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, val],
    },
AtomicRmwKw <_e: ElementwiseKw?> <op: AtomicOp> <ptr: TypeOp> Comma <val: TypeOp> <_sync: SyncScope?> <ord: Ident> <_align: (Comma Align IntLit)?> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![op, ord],
        result: None,
        opcode: "atomicrmw".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, val],
    },
    CmpxchgKw Weak Volatile <ptr: TypeOp> Comma <cmp: TypeOp> Comma <new: TypeOp> <_sync: SyncScope?> <succ: Ident> <fail: Ident> <_align: (Comma Align IntLit)?> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: true,
        align: 0,
        flags: vec![succ, fail],
        result: None,
        opcode: "cmpxchg".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, cmp, new],
    },
CmpxchgKw Weak <ptr: TypeOp> Comma <cmp: TypeOp> Comma <new: TypeOp> <_sync: SyncScope?> <succ: Ident> <fail: Ident> <_align: (Comma Align IntLit)?> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec!["weak".to_string(), succ, fail],
        result: None,
        opcode: "cmpxchg".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, cmp, new],
    },
    CmpxchgKw Volatile <ptr: TypeOp> Comma <cmp: TypeOp> Comma <new: TypeOp> <_sync: SyncScope?> <succ: Ident> <fail: Ident> <_align: (Comma Align IntLit)?> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: true,
        align: 0,
        flags: vec![succ, fail],
        result: None,
        opcode: "cmpxchg".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, cmp, new],
    },
CmpxchgKw <ptr: TypeOp> Comma <cmp: TypeOp> Comma <new: TypeOp> <_sync: SyncScope?> <succ: Ident> <fail: Ident> <_align: (Comma Align IntLit)?> <metas: CommaAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![succ, fail],
        result: None,
        opcode: "cmpxchg".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![ptr, cmp, new],
    },
    // landingpad <resultty> <clause>[, <clause>...]（clause = cleanup | catch <ty> @f | filter <ty> @f）。
    // flags 存子句名序列；args[0] = 结果类型（undef 占位）；args[1..] = catch/filter 的 (ty, fn) 操作数。
    LandingPadKw <ty: ValueType> <c0: LandingPadClause> <rest: (Comma <LandingPadClause>)*> <metas: MetadataAttach*> => {
        let mut clauses = vec![c0];
        clauses.extend(rest);
        let mut flags = Vec::new();
        let mut args = vec![ParsedOperand { ty: ty, op: Operand::Undef }];
        for (name, op) in &clauses {
            flags.push(name.clone());
            if let Some(op) = op {
                args.push(op.clone());
            }
        }
        ParsedInst {
            endian: false,
            volatile: false,
            align: 0,
            flags,
            result: None,
            opcode: "landingpad".to_string(),
            cond: None,
            phi_incomings: vec![],
            arg_attrs: vec![],
            call_fn_attrs: vec![],
            metadata_attach: metas,
            args,
        }
    },
    FenceKw <_sync: SyncScope?> <ord: Ident> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![ord],
        result: None,
        opcode: "fence".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: vec![],
    },
    // 调用（LLVM：tail 在 call 前）：[tail|musttail] call [fastcc] <retty> <callee>(<args>)
    // 显式 6 分支（tail × fastcc 组合）规避 CallCcKw 的 epsilon LR 冲突
    Tail Call Fastcc <ret: Type> <callee: Value> LParen <args: CallArgList> RParen <attrs: CallAttrs?> <metas: CommaAttach*> <_conv: (LBracket StrLit LParen TokenKw LocalId RParen RBracket)?> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec!["tail".to_string(), "fastcc".to_string()],
        result: None,
        opcode: "call".to_string(),
        cond: None,
        phi_incomings: vec![],
        args: {
            let mut v = args.0;
            v.insert(0, ParsedOperand { ty: ret, op: callee });
            v
        },
        arg_attrs: {
            let mut v = args.1;
            v.insert(0, vec![]);
            v
        },
        call_fn_attrs: attrs.unwrap_or_default(),
        metadata_attach: metas,
    },
    // tail inline asm：`tail call void asm sideeffect "mov", "~{...}"()`
    Tail Call <ret: Type> AsmKw <_side: (Ident)*> <_s1: StrLit> <_rest: (Comma StrLit)*> LParen <args: CallArgList> RParen <attrs: CallAttrs?> <metas: CommaAttach*> <_conv: (LBracket StrLit LParen TokenKw LocalId RParen RBracket)?> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        // inline asm(第二十九轮重建:asm 串/约束入 flags,display 还原)
        flags: {
            let mut f = vec!["tail".to_string(), "asm".to_string()];
            f.push(format!("asm:{_s1}"));
            for c in _rest {
                f.push(format!("asmc:{}", c.1));
            }
            f
        },
