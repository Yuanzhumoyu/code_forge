    // alloca：alloca <ty> [, i32 <count>]
    // alloca [inalloca] <ty> <rest>（rest 见 AllocaOpt，任意顺序）
    Alloca <inalloca: InallocaKw?> <ty: Type> <rest: (AllocaOpt)*> <metas: CommaAttach*> => {
        let mut align = 0u64;
        let mut args = vec![ParsedOperand { ty: ty, op: Operand::Null }];
        let mut flags = Vec::new();
        if inalloca.is_some() {
            flags.push("inalloca".to_string());
        }
        // LLVM 的 alloca 参数顺序固定：count → align → addrspace（addrspace
        // 必须最后——`alloca i32, addrspace(1), align 4` 被 llvm-as 拒绝，
        // 官方负向用例 alloca-addrspace-parse-error-1）
        let mut seen_addrspace = false;
        for (kind, op, val) in rest {
            match kind.as_str() {
                "count" => {
                    if let Some(op) = op {
                        args.push(op);
                    }
                }
                "align" => {
                    if seen_addrspace {
                        flags.push("addrspace-order-error".to_string());
                    }
                    align = val as u64;
                }
                "addrspace" => {
                    seen_addrspace = true;
                    flags.push(format!("addrspace:{val}"))
                }
                _ => {}
            }
        }
        ParsedInst {
            endian: false,
            volatile: false,
            align,
            result: None,
            opcode: "alloca".to_string(),
            cond: None,
            phi_incomings: vec![],
            arg_attrs: vec![],
            call_fn_attrs: vec![],
            metadata_attach: metas,
            flags,
            args,
        }
    },
