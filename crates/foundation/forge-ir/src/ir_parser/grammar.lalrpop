        endian: false,
        volatile: true,
        align: 0,
        result: None,
        opcode: "store".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: vec![val, addr],
    },
    Store Volatile <val: TypeOp> Comma <addr: TypeOp> Comma Align <n: IntLit> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: true,
        align: crate::ir_parser::ast_items::big_as_u64(&n),
        result: None,
        opcode: "store".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: vec![val, addr],
    },
    // getelementptr：getelementptr [inbounds] [nuw] [nusw] <base>, <ptr>, <idx>...
    //（M3 标志类：nuw/nusw 任意顺序组合，flags 顺序保留）
    GetElementPtr <flags: GepFlagSeq> <base: Type> Comma <ptr: TypeOp> <idxs: GepIdx*> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: flags,
        result: None,
        opcode: "getelementptr".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        args: {
            let mut v = vec![ParsedOperand { ty: base, op: Operand::Null }, ptr];
            v.extend(idxs);
            v
        },
    },
    GetElementPtr <base: Type> Comma <ptr: TypeOp> <idxs: GepIdx*> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: "getelementptr".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: {
            let mut v = vec![ParsedOperand { ty: base, op: Operand::Undef }, ptr];
            v.extend(idxs);
            v
        },
    },
    // 转换：sext/zext/trunc/bitcast <src> to <dst>（可选标志：
    // `zext nneg i32 %a to i64` / `trunc nsw i64 %a to i32`——M3 标志类）
    <op: ConvOp> <flags: InstFlagSeq> <src: TypeOp> To <dst: Type> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: flags,
        args: vec![src, ParsedOperand { ty: dst, op: Operand::Undef }],
    },
    <op: ConvOp> <src: TypeOp> To <dst: Type> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: op,
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: vec![src, ParsedOperand { ty: dst, op: Operand::Undef }],
    },
    // undef/poison 值指令（forge 扩展：%u = undef i32）
    Undef <ty: ValueType> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: "undef".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: vec![ParsedOperand { ty: ty, op: Operand::Undef }],
    },
    Poison <ty: ValueType> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        result: None,
        opcode: "poison".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: vec![ParsedOperand { ty: ty, op: Operand::Poison }],
    },

    // phi <ty> [ <val>, %pred ], ...（标准 LLVM；forge 内部转块参数）
    Phi <ty: Type> <incs: PhiIncomingList> <metas: MetadataAttach*> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: "phi".to_string(),
        cond: None,
        args: vec![ParsedOperand { ty: ty, op: Operand::Undef }],
        phi_incomings: incs,
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
    },
    // vconst <ty> [<lane>, ...] [big]（forge 扩展——向量常量数据 round-trip；
    // lanes 缺失时退化为 vconst <ty>；`big` 标记 lane 大端字节序）
    VconstOp <ty: ValueType> <lanes: VconstLanes?> <endian: EndianKw?> <metas: MetadataAttach*> => ParsedInst {
        endian: endian.unwrap_or(false),
        volatile: false,
        align: 0,
        result: None,
        opcode: "vconst".to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: metas,
        flags: vec![],
        args: {
            let mut v = vec![ParsedOperand { ty: ty.clone(), op: Operand::Undef }];
            v.extend(
                lanes
                    .unwrap_or_default()
                    .into_iter()
                    .map(|op| ParsedOperand { ty: ty.clone(), op }),
            );
            v
        },
    },
    // 通用：<op> [nsw nuw exact fast nnan ...] <ty> <val>, ...（操作数可选——
    // nop 等无操作数指令；标志流 (X)* X 至少 1 个，规避与 TypeOps? 的 LR 冲突）
    <op: Ident> <flags: InstFlagSeq> <args: TypeOps?> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: flags,
        result: None,
        opcode: op.to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: vec![],
        args: args.unwrap_or_default(),
    },
    <op: Ident> <args: TypeOps?> => ParsedInst {
        endian: false,
        volatile: false,
        align: 0,
        flags: vec![],
        result: None,
        opcode: op.to_string(),
        cond: None,
        phi_incomings: vec![],
        arg_attrs: vec![],
        call_fn_attrs: vec![],
        metadata_attach: vec![],
        args: args.unwrap_or_default(),
    },
};
// load atomic 的 syncscope 子句（LLVM：`syncscope("singlethread")`）——
// 专用 token 避免与 memord Ident 冲突
SyncScope: String = {
    SyncscopeKw LParen <_s: StrLit> RParen => _s,
};

// shufflevector 掩码：MaskVecLit（`<i32 0, ...>`）或 VecConstLit
// （`<4 x i32> <i32 0, ...>`——VecTy+lane 合并格式）
MaskOrConst: String = {
    <m: MaskVecLit> => m,
    <c: VecConstLit> => c,
};



// 指令标志流（≥1 个）：算术 `nsw`/`nuw`/`exact` + fast-math `fast`/`nnan`/`ninf`/...
// （仅对应指令类别合法——verify 检查）
InstFlagSeq: Vec<String> = {
    <mut v: (<InstFlag>)*> <f: InstFlag> => {
        v.push(f);
        v
    },
};

InstFlag: String = {
    Nsw => "nsw".to_string(),
    Nuw => "nuw".to_string(),
    Exact => "exact".to_string(),
    Nneg => "nneg".to_string(),
    Disjoint => "disjoint".to_string(),
    Fast => "fast".to_string(),
    Nnan => "nnan".to_string(),
    Ninf => "ninf".to_string(),
    Nsz => "nsz".to_string(),
    Arcp => "arcp".to_string(),
    Contract => "contract".to_string(),
    Afn => "afn".to_string(),
    Reassoc => "reassoc".to_string(),
    <v: ParenAttrKw> => v,
};

CompareOp: String = {
    Icmp => "icmp".to_string(),
    Fcmp => "fcmp".to_string(),
};

// 二元指令 opcode 集（S2 专用 token——见 lexer.rs；与 Ident 分离以支持
// 单类型第二操作数的专用规则）
BinaryOp: String = {
    Add => "add".to_string(),
    Sub => "sub".to_string(),
    Mul => "mul".to_string(),
    Udiv => "udiv".to_string(),
    Sdiv => "sdiv".to_string(),
    Urem => "urem".to_string(),
    Srem => "srem".to_string(),
    Shl => "shl".to_string(),
    Lshr => "lshr".to_string(),
    Ashr => "ashr".to_string(),
    And => "and".to_string(),
    Or => "or".to_string(),
    Xor => "xor".to_string(),
    Fadd => "fadd".to_string(),
    Fsub => "fsub".to_string(),
    Fmul => "fmul".to_string(),
    Fdiv => "fdiv".to_string(),
    Frem => "frem".to_string(),
};

ConvOp: String = {
    Sext => "sext".to_string(),
    Zext => "zext".to_string(),
    Trunc => "trunc".to_string(),
    Fptrunc => "fptrunc".to_string(),
    Fpext => "fpext".to_string(),
    Fptosi => "fptosi".to_string(),
    Sitofp => "sitofp".to_string(),
    Fptoui => "fptoui".to_string(),
    Uitofp => "uitofp".to_string(),
    Ptrtoint => "ptrtoint".to_string(),
    Inttoptr => "inttoptr".to_string(),
    Bitcast => "bitcast".to_string(),
    AddrspaceCastKw => "addrspacecast".to_string(),
    PtrtoaddrKw => "ptrtoaddr".to_string(),
};

// landingpad 子句：`cleanup` 或 `catch <ty> @f` / `filter <ty> @f`（关键字名宽松，semantics 校验）
LandingPadClause: (String, Option<ParsedOperand>) = {
    <kw: Ident> => (kw, None),
    <kw: Ident> <op: TypeOp> => (kw, Some(op)),
};

// alloca 尾选项（任意顺序，每个以 Comma 开头完整匹配：`<ty> <count>` / `align N` / `addrspace(N)`）
AllocaOpt: (String, Option<ParsedOperand>, u64) = {
    Comma <n: TypeOp> => ("count".to_string(), Some(n), 0u64),
    Comma Align <a: IntLit> => ("align".to_string(), None, crate::ir_parser::ast_items::big_as_u64(&a)),
    Comma AddrspaceKw LParen <n: IntLit> RParen => ("addrspace".to_string(), None, crate::ir_parser::ast_items::big_as_u64(&n)),
    // 符号化地址空间（alloca i32, addrspace("A")）——宽松 0
    Comma AddrspaceKw LParen <_s: StrLit> RParen => ("addrspace".to_string(), None, 0u64),
};

// phi 入边列表：`[ <val>, %pred ], [ <val>, %pred ], ...`（≥1 条）
PhiIncomingList: Vec<PhiIncoming> = {
    <mut v: (<PhiIncoming> Comma)*> <last: PhiIncoming> => {
        v.push(last);
        v
    },
    // 零入边 phi（LLVM：`%r = phi i32`——dead phi；第十二轮）
    => vec![],
};

PhiIncoming: PhiIncoming = {
    LBracket <v: PhiValue> Comma <l: LocalId> RBracket => PhiIncoming {
        val: v,
        pred: crate::ir_parser::ast_items::LabelRef::named(l.trim_start_matches('%').to_string()),
    },
};

// phi 入边值：`%name` 或裸字面量（类型由 phi 头类型决定；这里 ty 仅占位）
PhiValue: ParsedOperand = {
    <l: LocalId> => ParsedOperand { ty: ParsedType::Int(32), op: Operand::Local(l) },
    <n: IntLit> => ParsedOperand { ty: ParsedType::Int(32), op: Operand::Int(crate::ir_parser::ast_items::big_as_i64(&n)) },
    <n: HexLit> => ParsedOperand { ty: ParsedType::Int(32), op: Operand::UInt(crate::ir_parser::ast_items::big_as_u64(&n)) },
    <f: FloatLit> => ParsedOperand { ty: ParsedType::Float(32), op: Operand::Float(f) },
    Undef => ParsedOperand { ty: ParsedType::Int(32), op: Operand::Undef },
    Poison => ParsedOperand { ty: ParsedType::Int(32), op: Operand::Poison },
    Null => ParsedOperand { ty: ParsedType::Ptr, op: Operand::Null },
};

TypeOps: Vec<ParsedOperand> = {
    <mut v: (<TypeOp> Comma)*> <p: TypeOp> => {
        v.push(p);
        v
    }
};

// atomicrmw 操作名：S2 起二元指令为专用 token（add/sub/and/or/xor/fadd/fsub），
// 其余操作名（xchg/max/min/nand/uinc_wrap/...）仍走 Ident——合并两者。
AtomicOp: String = {
    <b: BinaryOp> => b,
    <i: Ident> => i,
};

// icmp/fcmp 操作数：固定 2 个类型化操作数 + 可选 `, !prof !0`（尾逗号 attach）。
// 独立规则避免把尾逗号引入通用 TypeOps 闭包（后者 2-lookahead 必冲突）。
// icmp/fcmp 第二操作数的标量子集（无聚合常量——LBrace/LBracket 与
// TypeOp 的 struct/数组类型 LALR(1) 本质冲突，见附录 §6）
CmpScalarValue: Operand = {
    <v: LocalId> => Operand::Local(v),
    <g: GlobalId> => Operand::Global(g),
    <n: IntLit> => Operand::Int(crate::ir_parser::ast_items::big_as_i64(&n)),
    <n: HexLit> => Operand::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    // 浮点十六进制位模式（宽松 0）
    <n: FloatHexLit> => Operand::UInt(n as u64),
    <f: FloatLit> => Operand::Float(f),
    <fh: HexFloatLit> => Operand::Float(fh),
    True => Operand::Bool(true),
    False => Operand::Bool(false),
    Null => Operand::Null,
    Undef => Operand::Undef,
    Poison => Operand::Poison,
    // `token none`（LLVM token 类型字面量——宽松映射 Undef）
    NoneKw => Operand::Undef,
    ZeroInitKw => Operand::ZeroInit,
    // 常量表达式第二操作数：`add <4 x i32> %a, splat (i32 137)`（M3/S6 扩展）
    <e: GlobalConstExpr> => Operand::ConstExpr(e),
};

CmpOps: (Vec<ParsedOperand>, Vec<(String, MetadataRef)>) = {
    <a: TypeOp> Comma <b: TypeOp> <metas: CommaAttach*> => (vec![a, b], metas),
    // LLVM 现代语法：第二操作数无类型（`fcmp olt float 1.5, 2.5`——类型从第一推导）
    <a: TypeOp> Comma <b: CmpScalarValue> <metas: CommaAttach*> => {
        let a_ty = a.ty.clone();
        (vec![a, ParsedOperand { ty: a_ty, op: b }], metas)
    },
};

// 二元指令操作数（S2）：固定 2 个操作数 + 尾 metadata attach。与 CmpOps
// 同构：第二操作数可为标量子集（无聚合常量——LBrace/LBracket 与 TypeOp 的
// struct/数组类型 LALR(1) 本质冲突，见附录 §6）。
BinaryOps: (Vec<ParsedOperand>, Vec<(String, MetadataRef)>) = {
    <a: TypeOp> Comma <b: TypeOp> <metas: CommaAttach*> => (vec![a, b], metas),
    // LLVM 现代语法：第二操作数无类型（`add i32 %a, %b`——类型从第一推导）
    <a: TypeOp> Comma <b: CmpScalarValue> <metas: CommaAttach*> => {
        let a_ty = a.ty.clone();
        (vec![a, ParsedOperand { ty: a_ty, op: b }], metas)
    },
};

// vconst lane 值列表：`[<lane>, ...]`（≥1 个；IntLit/FloatLit/HexLit 裸值）
VconstLanes: Vec<Operand> = {
    LBracket <mut v: (<VconstLane> Comma)*> <p: VconstLane> RBracket =>? {
        v.push(p);
        Ok(v)
    }
};

VconstLane: Operand = {
    <n: IntLit> => Operand::Int(crate::ir_parser::ast_items::big_as_i64(&n)),
    <n: HexLit> => Operand::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    // 浮点十六进制位模式（宽松 0）
    <n: FloatHexLit> => Operand::UInt(n as u64),
    <f: FloatLit> => Operand::Float(f),
    <fh: HexFloatLit> => Operand::Float(fh),
};

// 端序标记：`big`（缺省 Little）
EndianKw: bool = {
    Big => true,
};

// call 实参：`<ty> <attrs?> <value>`（LLVM：属性在类型后、值前）
CallArgList: (Vec<ParsedOperand>, Vec<Vec<String>>) = {
    => (vec![], vec![]),
    // 可变参数调用（`call void @f(ptr %p, ...)`——第十五轮 musttail）
    <mut v: (<CallArg> Comma)*> Ellipsis =>? {
        let mut ops = Vec::new();
        let mut attrs = Vec::new();
        for (o, a) in v {
            ops.push(o);
            attrs.push(a);
        }
        ops.push(ParsedOperand {
            ty: crate::ir_parser::ast_items::ParsedType::Void,
            op: Operand::Undef,
        });
        attrs.push(vec![]);
        Ok((ops, attrs))
    },
    <mut v: (<CallArg> Comma)*> <p: CallArg> =>? {
        let mut ops = Vec::new();
        let mut attrs = Vec::new();
        for (o, a) in v {
            ops.push(o);
            attrs.push(a);
        }
        let (o, a) = p;
        ops.push(o);
        attrs.push(a);
        Ok((ops, attrs))
    }
};

// call-site 函数属性：`(nounwind|noinline|...)+` 或 `#N`（LLVM 属性组引用）
CallAttrs: Vec<String> = {
    <mut v: (<FuncAttr>)+> => v,
    <id: AttrGroupId> => vec![format!("#{id}")],
};

CallArg: (ParsedOperand, Vec<String>) = {
    <ty: ValueType> <v: Value> => (ParsedOperand { ty, op: v }, vec![]),
    <ty: ValueType> <attrs: ParamAttrs> <v: Value> => (ParsedOperand { ty, op: v }, attrs),
    // elementtype 参数（`ptr elementtype(void ()) @func`——GC statepoint；
    // 第十七轮——修饰宽松丢弃；函数类型内嵌形态 LR 冲突记录）
    <ty: ValueType> ElementtypeKw LParen <_t: Type> RParen <v: Value> => (ParsedOperand { ty, op: v }, vec![]),
    // elementtype 内嵌函数类型（`ptr elementtype(void ()) @func`——lexer
    // 合并单 token,修饰宽松丢弃;T2-3）
    <ty: ValueType> ElementtypeFnKw <v: Value> => (ParsedOperand { ty, op: v }, vec![]),
    // 命名类型参数（`call %ty @f(%ty %arg)`——%ty 是 type 定义；第十二轮）
    <ty: LocalId> <v: Value> => (
        ParsedOperand { ty: crate::ir_parser::ast_items::ParsedType::Named(ty), op: v },
        vec![],
    ),
    // metadata 类型参数（调试 intrinsic）：`metadata i32 0`（类型化值）/
    // `metadata !10` / `metadata !{}` / `metadata !name`（引用——宽松 Undef）
    MetadataKw <op: TypeOp> => (
        ParsedOperand { ty: ParsedType::Metadata, op: op.op },
        vec![],
    ),
    MetadataKw <_n: MetadataIdKw> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Undef },
        vec![],
    ),
    MetadataKw <_n: MetadataNodeDef> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Undef },
        vec![],
    ),
    // metadata 局部值引用（`metadata %after`——前向引用 UndefNamed 保留名,
    // display 输出 `metadata %name`;第二十九轮重建）
    MetadataKw <_l: LocalId> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Local(_l) },
        vec![],
    ),
    // metadata undef / null（LLVM 合法值）
    MetadataKw <_u: Undef> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Undef },
        vec![],
    ),
    MetadataKw Null => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Null },
        vec![],
    ),
    MetadataKw <_n: MetadataNameKw> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Undef },
        vec![],
    ),
    // metadata 字符串字面量（`metadata !"Float8E5M2"`——类型名作字符串；
    // 第十二轮）——宽松 Undef
    MetadataKw Bang <_s: StrLit> => (
        ParsedOperand { ty: ParsedType::Metadata, op: Operand::Undef },
        vec![],
    ),
};

TypeOp: ParsedOperand = {
    <ty: ValueType> <v: Value> => ParsedOperand { ty: ty, op: v },
    // target extension type 操作数（`ret target("spirv.Sampler") %a` 等指令
    // 操作数位置——ValueType 加 Target 分支致 2052 冲突(§2.6)，局部展开）
    Target LParen <_args: TargetArgList> RParen <v: Value> => ParsedOperand {
        ty: ParsedType::Opaque,
        op: v,
    },
    // 旧式匿名聚合指针操作数（`store ..., {{i32},{float, double}}* %p`——
    // insertextractvalue.ll；TypedPtrKw 局部展开，宽松映射 Ptr）
    <_t: TypedPtrKw> <v: Value> => ParsedOperand {
        ty: ParsedType::Ptr,
        op: v,
    },
    // 向量常量字面量（lexer 单 token）：`<4 x float> <1.5, 2.5, -3.5, 4.25>`
    <lit: VecConstLit> => {
        let (ty, lanes) = crate::ir_parser::ast_items::split_vec_const_lit(&lit);
        ParsedOperand { ty: ty, op: Operand::VecConst(lanes) }
    },
    // `zeroinitializer` 关键字（lexer 单 token，标量/向量）
    <lit: ZeroInitLit> => ParsedOperand {
        ty: crate::ir_parser::ast_items::split_scalar_ty(&lit),
        op: Operand::ZeroInit,
    },
    <lit: VecZeroInitLit> => ParsedOperand {
        ty: crate::ir_parser::ast_items::split_vec_const_lit(&lit).0,
        op: Operand::ZeroInit,
    },

    // metadata 类型操作数（call 参数等调试 intrinsic）：
    // `metadata i32 0`（类型化值——op 取内层值）/ `metadata !10` /
    // `metadata !{}` / `metadata !name`（引用——宽松 Undef）
    MetadataKw <op: TypeOp> => ParsedOperand {
        ty: crate::ir_parser::ast_items::ParsedType::Metadata,
        op: op.op,
    },
    MetadataKw <_n: MetadataIdKw> => ParsedOperand {
        ty: crate::ir_parser::ast_items::ParsedType::Metadata,
        op: Operand::Undef,
    },
    MetadataKw <_n: MetadataNameKw> => ParsedOperand {
        ty: crate::ir_parser::ast_items::ParsedType::Metadata,
        op: Operand::Undef,
    },
    MetadataKw <_n: MetadataNodeDef> => ParsedOperand {
        ty: crate::ir_parser::ast_items::ParsedType::Metadata,
        op: Operand::Undef,
    },
};




// getelementptr 的单个索引：`, <ty> <idx>`（GepIdx* 支持零个或多个）
GepIdx: ParsedOperand = {
    Comma <p: TypeOp> => p,
};

// getelementptr 标志序列（≥1；任意组合）：inbounds / nuw / nusw / inrange(lo, hi)
GepFlagSeq: Vec<String> = {
    <mut v: (GepFlag)*> <f: GepFlag> => {
        v.push(f);
        v
    },
};

GepFlag: String = {
    Inbounds => "inbounds".to_string(),
    Nuw => "nuw".to_string(),
    Nusw => "nusw".to_string(),
    InrangeKw LParen <lo: IntLit> Comma <hi: IntLit> RParen => format!("inrange({lo}, {hi})"),
};

// ── 终结符 ──

// 带可选块参数的标签引用：label %t / label %t(i32 %v, i64 %w)
// 标签引用：`%N`（纯数字）→ 数字块 id 引用；`%"2"`/`%-3`/`%name` → 字符串标签名。
LabelRef: crate::ir_parser::ast_items::LabelRef = {
    LabelTy <t: LocalId> => {
        // `%"2"` 带引号字符串标签 → 去引号解码（lexer 产出含引号的 LocalId）；
        // `%2`/`%name` → 数字 id 引用或字符串名
        let raw = t.trim_start_matches('%');
        if raw.starts_with('"') && raw.ends_with('"') && raw.len() >= 2 {
            crate::ir_parser::ast_items::LabelRef {
                name: String::from_utf8_lossy(
                    &crate::ir_parser::ast_items::decode_c_string(
                        &raw[1..raw.len() - 1].to_string(),
                    ),
                )
                .into_owned(),
                is_num: false,
            }
        } else {
            crate::ir_parser::ast_items::LabelRef::named(raw.to_string())
        }
    },
    // 字符串标签引用（LLVM：`br label %"2"` 的引号形态已由 LocalId 处理；
    // 本分支兜底裸引号串）
    LabelTy <t: StrLit> => crate::ir_parser::ast_items::LabelRef {
        name: t,
        is_num: false,
    },
};

// personality 函数：`personality ptr @__gxx_personality_v0`（关键字名宽松，semantics 不校验）
Personality: String = {
    <_kw: Ident> <_ty: Type> <fname: GlobalId> => fname,
};

// #dbg_* 参数（宽松形态：类型化值/!N 引用/!Named(...) 命名节点——
// 第二十一轮 dbg-record 参数形状校验）
DbgArg: () = {
    <_v: TypeOp> => (),
    <_n: MetadataIdKw> => (),
    <_n: MetadataNameKw> <rest: (LParen MetadataValList RParen)?> => (),
    Null => (),
};

// #dbg_* 的 !ref 参数（第 2/4/6 参——DILocation/DIAssignID 引用形态）
MdRef: () = {
    <_n: MetadataIdKw> => (),
    <_n: MetadataNameKw> => (),
};

Terminator: ParsedTerminator = {
    // callbr asm（`callbr i32 asm "", "=r,r,!i,!i"(i32 0)`——asm 体丢弃）
    CallbrKw <_ret: Type> AsmKw <_side: (Ident)*> <_s1: StrLit> <_rest: (Comma StrLit)*> LParen <_args: CallArgList> RParen <_tail: (To LabelTy LocalId (LBracket LabelTy LocalId (Comma LabelTy LocalId)* RBracket)?)?> <metas: CommaAttach*> => ParsedTerminator::Unreachable,
    // callbr（终结符）：`callbr <retty> @callee(args) to label %cont [label %kill, ...]`
    // （LLVM 间接跳转调用——宽松按 Jump 处理，标签列表丢弃）
    CallbrKw <_ret: Type> <_callee: Value> LParen <_args: CallArgList> RParen To LabelTy <_n: LocalId> LBracket LabelTy <_l: LocalId> <_rest: (Comma LabelTy LocalId)*> RBracket <metas: CommaAttach*> => ParsedTerminator::Jump(
        crate::ir_parser::ast_items::LabelRef::named(_n.trim_start_matches('%').to_string()),
        metas,
    ),
    Ret VoidTy <metas: CommaAttach*> => ParsedTerminator::Return(vec![], metas),
    // ret 命名类型值（`ret %ty %copy`——%ty 是 type 定义；第十二轮）
    Ret <ty: LocalId> <v: Value> <metas: CommaAttach*> => ParsedTerminator::Return(
        vec![ParsedOperand {
            ty: crate::ir_parser::ast_items::ParsedType::Named(ty),
            op: v,
        }],
        metas,
    ),
    Ret <op: TypeOp> <metas: CommaAttach*> => ParsedTerminator::Return(vec![op], metas),
    Br <t: LabelRef> <metas: CommaAttach*> => ParsedTerminator::Jump(t, metas),
    Br <c: TypeOp> Comma <t: LabelRef> Comma <f: LabelRef> <metas: CommaAttach*> => {
        ParsedTerminator::Branch(Some(c), t, f, metas)
    },
    Switch <d: TypeOp> Comma <def: LabelRef> LBracket <cases: (<SwitchCase>)*> RBracket <metas: CommaAttach*> => {
        ParsedTerminator::Switch(d, def, cases, metas)
    },
    // invoke <retty> @callee(args) to label %ok unwind label %pad（返回值可选绑定 `%r =`）
    // invoke 带显式函数类型：`invoke void (...) %p(ptr %p) to label %ok unwind label %pad`
    InvokeKw <ret: Type> LParen <_ftys: ParamList> RParen <callee: Value> LParen <args: CallArgList> RParen To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: None,
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    // invoke 普通形态：`invoke i32 @f(i32 1) to label %ok unwind label %pad`
    InvokeKw <ret: Type> <callee: Value> LParen <args: CallArgList> RParen To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: None,
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    // invoke 带 GC live 列表（statepoint：`invoke token (...) @f(...) ["gc-live"(ptr %b, ...)]`
    // ——GC statepoint 专用后缀经 lexer 合并为必选单 token,与无 gc 变体
    // 经 lookahead(GcLiveKw vs To)消歧,宽松丢弃）
    InvokeKw <ret: Type> LParen <_ftys: ParamList> RParen <callee: Value> LParen <args: CallArgList> RParen <_gc: GcLiveKw> To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: None,
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    <res: LocalId> Eq InvokeKw <ret: Type> LParen <_ftys: ParamList> RParen <callee: Value> LParen <args: CallArgList> RParen To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: Some(res.trim_start_matches('%').to_string()),
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    <res: LocalId> Eq InvokeKw <ret: Type> LParen <_ftys: ParamList> RParen <callee: Value> LParen <args: CallArgList> RParen <_gc: GcLiveKw> To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: Some(res.trim_start_matches('%').to_string()),
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    <res: LocalId> Eq InvokeKw <ret: Type> <callee: Value> LParen <args: CallArgList> RParen To LabelTy <norm: LocalId> <_unw: Ident> LabelTy <unw: LocalId> <metas: CommaAttach*> => {
        ParsedTerminator::Invoke {
            result: Some(res.trim_start_matches('%').to_string()),
            callee: format_operand_callee(&callee),
            ret_ty: ret,
            args: args.0,
            normal: crate::ir_parser::ast_items::LabelRef::named(norm.trim_start_matches('%').to_string()),
            unwind: crate::ir_parser::ast_items::LabelRef::named(unw.trim_start_matches('%').to_string()),
            metas,
        }
    },
    // resume <ty> %val（重新抛出）
    ResumeKw <v: TypeOp> <metas: CommaAttach*> => ParsedTerminator::Resume(v, metas),
    Unreachable <_metas: CommaAttach*> => ParsedTerminator::Unreachable,
};

SwitchCase: (i64, crate::ir_parser::ast_items::LabelRef) = {
    <_ty: ValueType> <n: IntLit> Comma <t: LabelRef> => {
        (crate::ir_parser::ast_items::big_as_i64(&n), t)
    },
};


// ── 类型 ──

Type: ParsedType = {
    <t: ValueType> => t,
    VoidTy => ParsedType::Void,
    <n: LocalId> => ParsedType::Named(n),
    // metadata 类型（declare 参数/返回位置：`declare void @llvm.dbg.value(metadata, ...)`）
    MetadataKw => ParsedType::Metadata,
    // target extension type（LLVM 18：`target("a", void, i8, 5, target("b"))`）
    // ——宽松映射 Opaque（第十三轮；参数混合列表仅语法消费）。
    // 第二十三轮:布局名 "type" 的裸 IntLit 参数拒绝
    //（invalid-target-type-mixed——"expected uint32 param"）;
    // 正向 target-type-mangled/params 的 "a" 布局裸参数合法
    Target LParen <args: TargetArgList> RParen =>? {
        if args.0 == "type" && args.1 {
            Err(lalrpop_util::ParseError::User {
                error: crate::ir_parser::lexer::LexError,
            })
        } else {
            Ok(ParsedType::Opaque)
        }
    },
    // 旧式 typed pointer（`%fum*`——宽松映射 Ptr；第十五轮）
    <_t: TypedPtrKw> => ParsedType::Ptr,
};

// target 类型参数列表（str/类型/int/嵌套 target 混合）
TargetArgList: (String, bool) = {
    => (String::new(), false),
    // 首参（布局名）
    <s: StrLit> <rest: (Comma TargetArg)*> => (s, rest.iter().any(|(_, b)| *b)),
    <f: TargetArg> <rest: (Comma TargetArg)*> => (String::new(), f || rest.iter().any(|(_, b)| *b)),
};

// 嵌套 target(...) 经 Type 分支自然递归（Type 含 target 分支）。
// 第二十三轮（invalid-target-type-mixed）：宽松恢复——正向
// target-type-mangled/params 用裸参数（"a" 布局合法）;仅布局名 "type"
// 的裸 IntLit 参数在 Target 分支语义拒绝（"expected uint32 param"）
TargetArg: bool = {
    <_t: Type> => false,
    <_n: IntLit> => true,
};

// 非 void 类型（指令操作数/函数参数用；void 仅作函数返回与 ret 特例）
ValueType: ParsedType = {
    <t: IntTy> => ParsedType::Int(t),
    <t: FloatTy> => ParsedType::Float(t),
    PtrTy => ParsedType::Ptr,
    OpaqueKw => ParsedType::Opaque,
    TokenKw => ParsedType::Token,
    <t: VecTy> => ParsedType::Vec(t.len, Box::new(t.elem.into())),
    <t: VscaleTy> => ParsedType::VecScalable(t.len, Box::new(t.elem.into())),
    // ptr addrspace(N)
    PtrTy AddrspaceKw LParen <n: IntLit> RParen => ParsedType::PtrAddrSpace(crate::ir_parser::ast_items::big_as_u32(&n)),
    // 符号化地址空间（LLVM：ptr addrspace("G")）——宽松 0
    PtrTy AddrspaceKw LParen <_s: StrLit> RParen => ParsedType::PtrAddrSpace(0),
    LBracket <n: IntLit> X <t: Type> RBracket => {
        ParsedType::Array(crate::ir_parser::ast_items::big_as_u64(&n), Box::new(t))
    },
    LBrace RBrace => ParsedType::Struct(vec![]),
    LBrace <tys: StructList> RBrace => ParsedType::Struct(tys),
    // 打包结构体（packed struct）：`<{ i32, i32 }>`（LLVM 现代语法）
    LAngle LBrace RBrace RAngle => ParsedType::StructPacked(vec![]),
    LAngle LBrace <tys: StructList> RBrace RAngle => ParsedType::StructPacked(tys),
    // 旧式指针 `T*`（pre-opaque-ptr）不再支持——仅最新版 LLVM IR（`ptr` 唯一指针类型）。
    // 注意：此分支删除后 `i32*`/`ptr*` 等输入直接 parse 拒绝（invalid-opaque-ptr 用例）。
};

StructList: Vec<ParsedType> = {
    <mut v: (<Type> Comma)*> <p: Type> =>? {
        v.push(p);
        Ok(v)
    }
};

// ── 值 ──

Value: Operand = {
    <v: LocalId> => Operand::Local(v),
    <g: GlobalId> => Operand::Global(g),
    <n: IntLit> => Operand::Int(crate::ir_parser::ast_items::big_as_i64(&n)),
    <n: HexLit> => Operand::UInt(crate::ir_parser::ast_items::big_as_u64(&n)),
    // 浮点十六进制位模式（宽松 0）
    <n: FloatHexLit> => Operand::UInt(n as u64),
    <f: FloatLit> => Operand::Float(f),
    <fh: HexFloatLit> => Operand::Float(fh),
    True => Operand::Bool(true),
    False => Operand::Bool(false),
    Null => Operand::Null,
    Undef => Operand::Undef,
    Poison => Operand::Poison,
    // `token none`（LLVM token 类型字面量——宽松映射 Undef）
    NoneKw => Operand::Undef,
    ZeroInitKw => Operand::ZeroInit,
    // 聚合常量字面量：[i32 1, i32 2]（数组）/ { i32 1, i64 2 }（struct）/ <{...}>（packed struct）；空聚合 `{}`/`[]` 合法
    LBracket RBracket => Operand::Agg(vec![]),
    LBracket <elems: AggList> RBracket => Operand::Agg(elems),
    LBrace RBrace => Operand::Agg(vec![]),
    LBrace <elems: AggList> RBrace => Operand::Agg(elems),
    LAngle LBrace RBrace RAngle => Operand::Agg(vec![]),
    LAngle LBrace <elems: AggList> RBrace RAngle => Operand::Agg(elems),
    // 常量表达式操作数：`ret i64 add (i64 <l>, i64 <r>)`（带类型前缀——
    // `<ty: ValueType> <v: Value>` 中 Value 处于第二位置，不膨胀 TypeOp first，
    // 避免 TypeOps/InstFlagSeq 闭包 LALR 冲突）。semantics 求值折叠。
    <e: GlobalConstExpr> => Operand::ConstExpr(e),
};

// 聚合字面量元素：`<ty> <value>`（可为嵌套聚合——LLVM `[[i32 1], ...]`/`{{i32 1}, ...}`）
AggList: Vec<ParsedOperand> = {
    <mut v: (<AggListElem> Comma)*> <p: AggListElem> =>? {
        v.push(p);
        Ok(v)
    }
};

AggListElem: ParsedOperand = {
    <t: TypeOp> => t,
    // 命名类型聚合元素（`{ %1 { i32 4 }, ... }`——%1 是 type 定义；第十四轮）
    <nty: LocalId> <nv: Value> => ParsedOperand {
        ty: crate::ir_parser::ast_items::ParsedType::Named(nty),
        op: nv,
    },
    // 嵌套聚合（非空——`{{}}` 与"空 struct 类型 + 值"的 TypeOp 在 LALR(1)
    // 下本质歧义，LLVM 同（空嵌套写法无实际用途））
    LBracket <first: AggListElem> <rest: (Comma <AggListElem>)*> RBracket => {
        let mut v = vec![first];
        v.extend(rest);
        ParsedOperand { ty: ParsedType::Void, op: Operand::Agg(v) }
    },
    LBrace <first: AggListElem> <rest: (Comma <AggListElem>)*> RBrace => {
        let mut v = vec![first];
        v.extend(rest);
        ParsedOperand { ty: ParsedType::Void, op: Operand::Agg(v) }
    },
};

